# Matched fixed-influence ESP i k point for Figure 5.
newton on
units real
atom_style full
read_data numerical_examples/water_trajectory_benchmark/water.data
reset_timestep 0

bond_style harmonic
angle_style harmonic
bond_coeff 1 0.0 1.000
angle_coeff 1 0.0 109.47
special_bonds lj/coul 0 0 0.5

pair_style coul/esp 9.0
kspace_style esp 1.0e-04 1.0e-04
kspace_modify order 5 diff ik mesh 12 12 12 cspread 12.024 influence fixed
pair_coeff * *

neighbor 1.0 bin
neigh_modify every 1 delay 0 check yes one 4000
thermo_style custom step atoms
thermo 100

# The Figure-5 runner writes force dumps only under ESP_ERROR_BENCH_OUTPUT_DIR.
rerun numerical_examples/water_trajectory_benchmark/water_short_traj.lammpstrj dump x y z ix iy iz box yes format native
