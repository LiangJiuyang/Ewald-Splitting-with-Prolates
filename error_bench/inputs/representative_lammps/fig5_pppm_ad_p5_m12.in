# Fixed-G PPPM-AD scan for Figure 5.
newton on
units real
atom_style full
read_data numerical_examples/water_trajectory_benchmark/water.data
reset_timestep 0

bond_style harmonic
angle_style harmonic
bond_coeff 1 0.0 1.000
angle_coeff 1 0.0 109.47
special_bonds lj/coul 0 0 0.5

neighbor 1.0 bin
neigh_modify every 1 delay 0 check yes one 2000
thermo_style custom step pe ecoul elong press
thermo_modify flush yes
thermo 100
pair_style coul/long 9.0
kspace_style pppm 1.0e-05
kspace_modify order 5 mesh 12 12 12
kspace_modify diff ad
kspace_modify gewald 0.33593464
pair_coeff * *

dump force all custom 1 inputs/representative_lammps/fig5_pppm_ad_p5_m12.forces.dump id fx fy fz
dump_modify force sort id format line "%d %.17g %.17g %.17g"
rerun numerical_examples/water_trajectory_benchmark/water_short_traj.lammpstrj dump x y z ix iy iz box yes format native
