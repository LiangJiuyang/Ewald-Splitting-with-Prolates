        # Automatically generated force calculation for the large all-atom water scan.
        newton on
        units real
        atom_style full
        read_data numerical_examples/water_trajectory_benchmark/water.data
        replicate 2 2 2
        reset_timestep 0

        bond_style harmonic
        angle_style harmonic
        bond_coeff 1 0.0 1.000
        angle_coeff 1 0.0 109.47
        special_bonds lj/coul 0 0 0.5

        pair_style lj/cut/coul/long 9.0
pair_coeff 1 1 0.15535 3.166
pair_coeff 1 2 0.0 1.0
pair_coeff 2 2 0.0 1.0
pair_modify table 0
kspace_style pppm 1.0e-04
        kspace_modify order 5 mesh 30 30 30 diff ik

        neighbor 1.0 bin
        neigh_modify every 1 delay 0 check yes one 2000
        thermo_style custom step pe ecoul elong press
        thermo 1
        dump f all custom 1 numerical_examples/large_water_window_upsampling/runs/selection/1e-4_pppm_m30_p5_frame1000/forces.dump id fx fy fz
        dump_modify f sort id format line "%d %.17g %.17g %.17g"
        rerun numerical_examples/large_water_window_upsampling/large_water_short_traj.lammpstrj first 1000 last 1000 every 1 dump x y z ix iy iz box yes format native
