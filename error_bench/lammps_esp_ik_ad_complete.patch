+
+static double zeta_even(int exponent)
+{
+  constexpr int nmax = 64;
+  double sum = 0.0;
+  for (int n = 1; n < nmax; n++) sum += std::pow(n, -exponent);
+
+  const double x = nmax;
+  const double s = exponent;
+  sum += std::pow(x, 1.0 - s) / (s - 1.0) + 0.5 * std::pow(x, -s);
+  sum += s / 12.0 * std::pow(x, -s - 1.0);
+  sum -= s * (s + 1.0) * (s + 2.0) / 720.0 * std::pow(x, -s - 3.0);
+  return sum;
+}
+
+static void symmetric_product(const double *a, const double *b, double *result)
+{
+  result[0] = a[0] * b[0];
+  result[1] = a[1] * b[1];
+  result[2] = a[2] * b[2];
+  result[3] = 0.5 * (a[0] * b[1] + a[1] * b[0]);
+  result[4] = 0.5 * (a[0] * b[2] + a[2] * b[0]);
+  result[5] = 0.5 * (a[1] * b[2] + a[2] * b[1]);
+}
