+/* ---------------------------------------------------------------------- */
+
+void ESPDisp::init_dispersion_coeffs(double **epsilon, double **sigma, double **pair_coefficients)
+{
+  const int ntypes = atom->ntypes;
+
+  for (int i = 1; i <= ntypes; i++)
+    if (epsilon[i][i] < 0.0 || sigma[i][i] < 0.0)
+      error->all(FLERR, "Kspace style esp/disp requires non-negative LJ coefficients");
+
+  delete[] B;
+  B = nullptr;
+  dispersion_weight.clear();
+  dispersion_truncation_error = 0.0;
+
+  const bool geometric = mixflag == 1 || (mixflag == 0 && dispersion_mixing != Pair::ARITHMETIC) ||
+      ntypes == 1;
+  if (geometric) {
+    ndisp_fields = 1;
+    dispersion_weight.assign(1, 1.0);
+    B = new double[ntypes + 1]();
+    for (int i = 1; i <= ntypes; i++) {
+      if (pair_coefficients[i][i] < 0.0)
+        error->all(FLERR, "Kspace style esp/disp requires non-negative diagonal C6 coefficients");
+      B[i] = std::sqrt(pair_coefficients[i][i]);
+    }
+    return;
+  }
+
+  double **coefficients, **eigenvectors;
+  memory->create(coefficients, ntypes, ntypes, "esp/disp:coefficients");
+  memory->create(eigenvectors, ntypes, ntypes, "esp/disp:eigenvectors");
+
+  double max_coefficient = 0.0;
+  for (int i = 1; i <= ntypes; i++)
+    for (int j = i; j <= ntypes; j++) {
+      const double coefficient = pair_coefficients[i][j];
+      coefficients[i - 1][j - 1] = coefficients[j - 1][i - 1] = coefficient;
+      max_coefficient = std::max(max_coefficient, std::abs(coefficient));
+    }
+
+  if (max_coefficient == 0.0) {
+    ndisp_fields = 1;
+    dispersion_weight.assign(1, 1.0);
+    B = new double[ntypes + 1]();
+    memory->destroy(coefficients);
+    memory->destroy(eigenvectors);
+    return;
+  }
+
+  std::vector<double> eigenvalues(ntypes);
+  using Diagonalizer = MathEigen::Jacobi<double, double *, double **>;
+  Diagonalizer diagonalizer(ntypes);
+  const int failed = diagonalizer.Diagonalize(coefficients, eigenvalues.data(), eigenvectors,
+                                              Diagonalizer::SORT_DECREASING_ABS_EVALS);
+  if (failed) error->all(FLERR, "Dispersion coefficient matrix factorization failed");
+
+  double eigenvalue_tolerance =
+      256.0 * std::numeric_limits<double>::epsilon() * ntypes * std::abs(eigenvalues[0]);
+  if (mixflag == 2 && splittol > 0.0)
+    eigenvalue_tolerance = std::max(eigenvalue_tolerance, splittol * std::abs(eigenvalues[0]));
+  int rank = 0;
+  while (rank < ntypes && std::abs(eigenvalues[rank]) > eigenvalue_tolerance) rank++;
+  if (mixflag == 2 && rank < ntypes && eigenvalues[0] != 0.0)
+    dispersion_truncation_error = std::abs(eigenvalues[rank] / eigenvalues[0]);
+  ndisp_fields = std::max(rank, 1);
+  dispersion_weight.assign(ndisp_fields, 0.0);
+  B = new double[ndisp_fields * (ntypes + 1)]();
+
+  for (int field = 0; field < rank; field++) {
+    dispersion_weight[field] = std::signbit(eigenvalues[field]) ? -1.0 : 1.0;
+    const double scale = std::sqrt(std::abs(eigenvalues[field]));
+    for (int i = 1; i <= ntypes; i++)
+      B[ndisp_fields * i + field] = scale * eigenvectors[field][i - 1];
+  }
+  if (rank == 0) dispersion_weight[0] = 1.0;
+
+  double max_error = 0.0;
+  for (int i = 1; i <= ntypes; i++)
+    for (int j = 1; j <= ntypes; j++) {
+      double reconstructed = 0.0;
+      for (int field = 0; field < ndisp_fields; field++)
+        reconstructed += dispersion_weight[field] * dispersion_coefficient(i, field) *
+            dispersion_coefficient(j, field);
+      max_error = std::max(max_error, std::abs(reconstructed - coefficients[i - 1][j - 1]));
+    }
+
+  const double reconstruction_tolerance =
+      std::max(1.0e-12, 4096.0 * std::numeric_limits<double>::epsilon() * ntypes) * max_coefficient;
+  if (mixflag != 2 && max_error > reconstruction_tolerance)
+    error->all(FLERR, "Dispersion coefficient matrix factorization is inaccurate");
+
+  memory->destroy(coefficients);
+  memory->destroy(eigenvectors);
+}
+
+/* ---------------------------------------------------------------------- */
+
+void ESPDisp::setup()
+{
+  ESP::setup();
+  if (triclinic && differentiation_flag == 0) compute_gf_ik_dispersion_triclinic();
+}
+
+/* ---------------------------------------------------------------------- */
+
+double ESPDisp::mesh_spacing() const
+{
+  const double kmax_coul = select_c / cutoff;
+  const double kmax_disp = select_c_disp / cutoff_disp;
+  return MY_PI / std::max(kmax_coul, kmax_disp);
+}
+
+/* ---------------------------------------------------------------------- */
+
+void ESPDisp::dispersion_pair_coeffs(const double *&force_coeffs, int &force_order,
+                                     const double *&energy_coeffs, int &energy_order) const
+{
+  force_coeffs = force_disp;
+  force_order = num_force_disp;
+  energy_coeffs = energy_disp;
+  energy_order = num_energy_disp;
+}
+
+/* ---------------------------------------------------------------------- */
+
+double ESPDisp::dispersion_coefficient(int type, int field) const
+{
+  return B[ndisp_fields * type + field];
+}
+
+/* ---------------------------------------------------------------------- */
+
+double ESPDisp::weighted_dispersion_coefficient(int type, int field) const
+{
+  return dispersion_weight[field] * dispersion_coefficient(type, field);
+}
+
+/* ---------------------------------------------------------------------- */
+
+double ESPDisp::dispersion_self_coefficient(int type) const
+{
+  double coefficient = 0.0;
+  for (int field = 0; field < ndisp_fields; field++)
+    coefficient +=
+        weighted_dispersion_coefficient(type, field) * dispersion_coefficient(type, field);
+  return coefficient;
+}
+
+/* ---------------------------------------------------------------------- */
+
+bool ESPDisp::has_dispersion_coefficient(int type) const
+{
+  for (int field = 0; field < ndisp_fields; field++)
+    if (dispersion_coefficient(type, field) != 0.0) return true;
+  return false;
+}
+
+/* ---------------------------------------------------------------------- */
+
+void ESPDisp::dispersion_sum()
+{
+  double local = 0.0;
+  int *type = atom->type;
+  for (int i = 0; i < atom->nlocal; i++) local += dispersion_self_coefficient(type[i]);
+  MPI_Allreduce(&local, &bsqsum, 1, MPI_DOUBLE, MPI_SUM, world);
+}
