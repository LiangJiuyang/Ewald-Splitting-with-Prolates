+
+void ESPDisp::pack_forward_grid(int flag, void *vbuf, int nlist, int *list)
+{
+  auto *buf = (FFT_SCALAR *) vbuf;
+  int n = 0;
+
+  if (flag == FORWARD_AD_G) {
+    FFT_SCALAR *coul = &u_brick[nzlo_out][nylo_out][nxlo_out];
+    for (int field = 0; field < ndisp_fields; field++)
+      scalar_disp_ptrs[field] = &u_disp_brick[field][nzlo_out][nylo_out][nxlo_out];
+    for (int i = 0; i < nlist; i++) {
+      buf[n++] = coul[list[i]];
+      for (int field = 0; field < ndisp_fields; field++)
+        buf[n++] = scalar_disp_ptrs[field][list[i]];
+    }
+  } else if (flag == FORWARD_IK_G) {
+    FFT_SCALAR *coul[3] = {&vdx_brick[nzlo_out][nylo_out][nxlo_out],
+                           &vdy_brick[nzlo_out][nylo_out][nxlo_out],
+                           &vdz_brick[nzlo_out][nylo_out][nxlo_out]};
+    for (int field = 0; field < ndisp_fields; field++)
+      for (int dim = 0; dim < 3; dim++)
+        vector_disp_ptrs[field][dim] = &field_disp_brick[field][dim][nzlo_out][nylo_out][nxlo_out];
+    for (int i = 0; i < nlist; i++) {
+      for (int dim = 0; dim < 3; dim++) buf[n++] = coul[dim][list[i]];
+      for (int field = 0; field < ndisp_fields; field++)
+        for (int dim = 0; dim < 3; dim++) buf[n++] = vector_disp_ptrs[field][dim][list[i]];
+    }
+  } else if (flag == FORWARD_IK_PERATOM_G) {
+    for (int field = 0; field < ndisp_fields; field++) {
+      scalar_disp_ptrs[field] = &u_disp_brick[field][nzlo_out][nylo_out][nxlo_out];
+      for (int component = 0; component < 6; component++)
+        tensor_disp_ptrs[field][component] =
+            &virial_disp_brick[field][component][nzlo_out][nylo_out][nxlo_out];
+    }
+    for (int i = 0; i < nlist; i++) {
+      for (int field = 0; field < ndisp_fields; field++) {
+        if (eflag_atom) buf[n++] = scalar_disp_ptrs[field][list[i]];
+        if (vflag_atom)
+          for (int component = 0; component < 6; component++)
+            buf[n++] = tensor_disp_ptrs[field][component][list[i]];
+      }
+    }
+  } else if (flag == FORWARD_AD_PERATOM_G) {
+    for (int field = 0; field < ndisp_fields; field++)
+      for (int component = 0; component < 6; component++)
+        tensor_disp_ptrs[field][component] =
+            &virial_disp_brick[field][component][nzlo_out][nylo_out][nxlo_out];
+    for (int i = 0; i < nlist; i++)
+      for (int field = 0; field < ndisp_fields; field++)
+        for (int component = 0; component < 6; component++)
+          buf[n++] = tensor_disp_ptrs[field][component][list[i]];
+  } else
+    ESP::pack_forward_grid(flag, vbuf, nlist, list);
+}
