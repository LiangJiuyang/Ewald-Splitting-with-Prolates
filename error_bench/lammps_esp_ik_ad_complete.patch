+/* ----------------------------------------------------------------------
+   polynomial approximations for the short-range complement of -C6/r^6
+------------------------------------------------------------------------- */
+
+void dispersion_energy_poly(double tol_coeff, const double &c, std::vector<double> &coeffs)
+{
+  Prolate0Fun prolate(c, 10000);
+  const double psi0 = prolate.eval_derivatives(0.0, 0)[0];
+
+  auto short_range = [&prolate, psi0](double x) {
+    const auto dpsi = prolate.eval_derivatives(x, 2);
+    const double w = dpsi[0] / psi0;
+    const double wp = dpsi[1] / psi0;
+    const double wpp = dpsi[2] / psi0;
+    const double long_range = 1.0 - w + 0.625 * x * wp - 0.125 * x * x * wpp;
+    return 1.0 - long_range;
+  };
+
+  mapped_monomial_poly(tol_coeff, short_range, coeffs);
+}
+
+void dispersion_force_poly(double tol_coeff, const double &c, std::vector<double> &coeffs)
+{
+  Prolate0Fun prolate(c, 10000);
+  const double psi0 = prolate.eval_derivatives(0.0, 0)[0];
+
+  auto short_range_force = [&prolate, psi0](double x) {
+    const auto dpsi = prolate.eval_derivatives(x, 3);
+    const double w = dpsi[0] / psi0;
+    const double wp = dpsi[1] / psi0;
+    const double wpp = dpsi[2] / psi0;
+    const double wppp = dpsi[3] / psi0;
+    const double long_range = 1.0 - w + 0.625 * x * wp - 0.125 * x * x * wpp;
+    const double long_range_derivative = -0.375 * wp + 0.375 * x * wpp - 0.125 * x * x * wppp;
+    return 1.0 - long_range + x * long_range_derivative / 6.0;
+  };
+
+  mapped_monomial_poly(tol_coeff, short_range_force, coeffs);
+}
+
+/* ----------------------------------------------------------------------
+   compact Fourier kernel for the long-range complement of +1/r^6
+------------------------------------------------------------------------- */
+
+void dispersion_fourier_poly(double tol_coeff, const double &c, double cutoff,
+                             std::vector<double> &coeffs)
+{
+  Prolate0Fun prolate(c, 10000);
+  const double c0 = prolate.int_eval(1.0);
+  const double prefactor = MY_PI * MY_PI / 12.0 * pow(c / cutoff, 3);
+
+  constexpr int nquad = 200;
+  std::array<double, nquad> quad_x{};
+  std::array<double, nquad> quad_w{};
+  gaussian_quadrature(nquad, quad_x.data(), quad_w.data());
+
+  auto kernel = [&prolate, c0, prefactor, &quad_x, &quad_w](double t) {
+    const double scale = 0.5 * (1.0 - t);
+    double m1 = 0.0;
+    double m3 = 0.0;
+    for (int i = 0; i < nquad; i++) {
+      const double x = t + scale * (quad_x[i] + 1.0);
+      const double base = prolate.eval_val(x) / c0;
+      m1 += quad_w[i] * x * base;
+      m3 += quad_w[i] * x * x * x * base;
+    }
+    m1 *= scale;
+    m3 *= scale;
+    const double i0 = prolate.int_eval(t) / c0;
+    const double q6 = t * t * t * (1.0 - i0) - 1.5 * t * t * m1 + 0.5 * m3;
+    return prefactor * q6;
+  };
+
+  mapped_monomial_poly(tol_coeff, kernel, coeffs);
+}
