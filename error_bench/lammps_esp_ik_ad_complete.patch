+  spreading_select_c = utils::numeric(FLERR, arg[1], false, lmp);
+  if (!std::isfinite(spreading_select_c) || spreading_select_c <= 0.0)
+    error->all(FLERR, "Kspace_modify cspread value must be finite and positive");
+
+  spreading_select_c_user = 1;
