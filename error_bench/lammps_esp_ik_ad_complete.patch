+/* ---------------------------------------------------------------------- */
+
+ESPDisp::ESPDisp(LAMMPS *lmp) :
+    ESP(lmp), cutoff_disp(0.0), select_c_disp(0.0), self_disp(0.0), bsqsum(0.0),
+    dispersion_mixing(Pair::GEOMETRIC), ndisp_fields(1), dispersion_truncation_error(0.0),
+    B(nullptr), dispersion_weight(1, 0.0), num_fourier_disp(0), fourier_disp(nullptr),
+    num_force_disp(0), num_energy_disp(0), force_disp(nullptr), energy_disp(nullptr),
+    greensfn_disp(nullptr), greensfn2_disp(nullptr), vg_disp(nullptr), vg2_disp(nullptr),
+    packed_dispersion_scale(1.0), remap_packed(nullptr), part2grid_disp(nullptr),
+    disp_sites(nullptr), ndisp(0), nmax_disp(0)
+{
+  dispersionflag = 1;
+  group_group_enable = 0;
+  for (double &coefficient : sf_coeff_disp) coefficient = 0.0;
+}
