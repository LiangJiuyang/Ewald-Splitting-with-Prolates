+/* ----------------------------------------------------------------------
+   pre-compute validation-only fixed-influence Green's function for ik
+
+   This is the diagonal multiplier used by the fixed-influence estimator:
+
+     G(k) = [2*pi*split_poly(2*r_c*|k|/c_split-1)/|k|^2]
+            / |W_P(k)|^2 .
+
+   The spreading transform follows the implementation convention used by
+   compute_gf_ad(): the project-local polynomial representation is evaluated
+   inside its radial support and is zero outside.  This convention is useful
+   for operator-matched code validation, but is not the exact PSWF outside
+   continuation used by the analytical all-alias estimator.
+------------------------------------------------------------------------- */
+
+void ESP::compute_gf_fixed_ik()
+{
+  const double * const prd = domain->prd;
+
+  const double xprd = prd[0];
+  const double yprd = prd[1];
+  const double zprd = prd[2];
+  const double zprd_slab = zprd * slab_volfactor;
+
+  const double unitkx = MY_2PI / xprd;
+  const double unitky = MY_2PI / yprd;
+  const double unitkz = MY_2PI / zprd_slab;
+  const double sqk_cut2 = square(select_c / cutoff);
+
+  const double scale_x = (order * MY_PI) / ((double) nx_pppm * spreading_select_c);
+  const double scale_y = (order * MY_PI) / ((double) ny_pppm * spreading_select_c);
+  const double scale_z = (order * MY_PI) / ((double) nz_pppm * spreading_select_c);
+
+  int n = 0;
+  for (int m = nzlo_fft; m <= nzhi_fft; ++m) {
+    const int mper = m - nz_pppm * (2 * m / nz_pppm);
+    const double qz = unitkz * (double) mper;
+    const double wz = spreading_weight2_from_abs_index(std::abs(mper), scale_z);
+
+    for (int l = nylo_fft; l <= nyhi_fft; ++l) {
+      const int lper = l - ny_pppm * (2 * l / ny_pppm);
+      const double qy = unitky * (double) lper;
+      const double wy = spreading_weight2_from_abs_index(std::abs(lper), scale_y);
+
+      for (int k = nxlo_fft; k <= nxhi_fft; ++k, ++n) {
+        const int kper = k - nx_pppm * (2 * k / nx_pppm);
