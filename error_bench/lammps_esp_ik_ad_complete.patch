+   Contributing author: Jiuyang Liang (Flatiron Institute), liangjiuyang@sjtu.edu.cn
+------------------------------------------------------------------------- */
+
+#include "pair_lj_long_coul_esp.h"
+
+#include "atom.h"
+#include "error.h"
+#include "esp_disp.h"
+#include "force.h"
+#include "kspace.h"
+#include "neigh_list.h"
+
+#include <cmath>
+#include <cstring>
+
+using namespace LAMMPS_NS;
+
+/* ---------------------------------------------------------------------- */
+
+PairLJLongCoulEsp::PairLJLongCoulEsp(LAMMPS *lmp) : PairLJCutCoulEsp(lmp)
+{
+  dispersionflag = 1;
+  respa_enable = 1;
+}
+
+/* ---------------------------------------------------------------------- */
+
+void PairLJLongCoulEsp::settings(int narg, char **arg)
+{
+  if (narg < 3 || narg > 4 || strcmp(arg[0], "long") != 0 || strcmp(arg[1], "long") != 0)
+    error->all(FLERR, "Illegal pair_style command");
+
+  PairLJCutCoulEsp::settings(narg - 2, arg + 2);
+}
+
+/* ---------------------------------------------------------------------- */
+
+void PairLJLongCoulEsp::init_style()
+{
+  PairLJCutCoulEsp::init_style();
+
+  auto *solver = dynamic_cast<ESPDisp *>(force->kspace);
+  if (!solver) error->all(FLERR, "Pair style lj/long/coul/esp requires kspace style esp/disp");
+  if (offset_flag) error->all(FLERR, "Cannot use pair_modify shift with lj/long/coul/esp");
+  if (tail_flag) error->all(FLERR, "Cannot use pair_modify tail with lj/long/coul/esp");
+
+  solver->dispersion_pair_coeffs(disp_force_poly, disp_force_order, disp_energy_poly,
+                                 disp_energy_order);
+}
+
+/* ---------------------------------------------------------------------- */
+
+double PairLJLongCoulEsp::init_one(int i, int j)
+{
+  const double cut = PairLJCutCoulEsp::init_one(i, j);
+  if (cut_lj[i][j] != 0.0 && std::abs(cut_lj[i][j] - cut_lj_global) > 1.0e-12)
+    error->all(FLERR, "Pair style lj/long/coul/esp requires one global LJ cutoff");
+  return cut;
+}
+
+/* ---------------------------------------------------------------------- */
+
+void PairLJLongCoulEsp::compute_outer(int eflag, int vflag)
+{
+  PairLJCutCoulEsp::compute(eflag, vflag);
+  subtract_respa_inner();
+}
+
+/* ---------------------------------------------------------------------- */
+
+void PairLJLongCoulEsp::subtract_respa_inner()
+{
+  if (!cut_respa) return;
+
+  double **x = atom->x;
+  double **f = atom->f;
+  double *q = atom->q;
+  int *type = atom->type;
+  const int nlocal = atom->nlocal;
+  const int newton_pair = force->newton_pair;
+  double *special_coul = force->special_coul;
+  double *special_lj = force->special_lj;
+
+  const double cut_in_off = cut_respa[2];
+  const double cut_in_on = cut_respa[3];
+  const double cut_in_diff = cut_in_on - cut_in_off;
+  const double cut_in_off_sq = cut_in_off * cut_in_off;
+  const double cut_in_on_sq = cut_in_on * cut_in_on;
+
+  for (int ii = 0; ii < list->inum; ii++) {
+    const int i = list->ilist[ii];
+    const int itype = type[i];
+    int *jlist = list->firstneigh[i];
+    const int jnum = list->numneigh[i];
+
+    for (int jj = 0; jj < jnum; jj++) {
+      int j = jlist[jj];
+      const double factor_lj = special_lj[sbmask(j)];
+      const double factor_coul = special_coul[sbmask(j)];
+      j &= NEIGHMASK;
+
+      const double delx = x[i][0] - x[j][0];
+      const double dely = x[i][1] - x[j][1];
+      const double delz = x[i][2] - x[j][2];
+      const double rsq = delx * delx + dely * dely + delz * delz;
+      const int jtype = type[j];
+      if (rsq >= cutsq[itype][jtype] || rsq >= cut_in_on_sq) continue;
+
+      double weight = 1.0;
+      if (rsq > cut_in_off_sq) {
+        const double rsw = (std::sqrt(rsq) - cut_in_off) / cut_in_diff;
+        weight -= rsw * rsw * (3.0 - 2.0 * rsw);
+      }
+
+      const double r2inv = 1.0 / rsq;
+      double force_pair = 0.0;
+      if (rsq < cut_coulsq)
+        force_pair += force->qqrd2e * q[i] * q[j] * std::sqrt(r2inv) * factor_coul;
+      if (rsq < cut_ljsq[itype][jtype]) {
+        const double r6inv = r2inv * r2inv * r2inv;
+        force_pair += factor_lj * r6inv * (lj1[itype][jtype] * r6inv - lj2[itype][jtype]);
+      }
+
+      const double fpair = -weight * force_pair * r2inv;
+      f[i][0] += delx * fpair;
+      f[i][1] += dely * fpair;
+      f[i][2] += delz * fpair;
+      if (newton_pair || j < nlocal) {
+        f[j][0] -= delx * fpair;
+        f[j][1] -= dely * fpair;
+        f[j][2] -= delz * fpair;
+      }
+    }
+  }
+}
+
+/* ---------------------------------------------------------------------- */
+
+void *PairLJLongCoulEsp::extract(const char *str, int &dim)
+{
+  dim = 2;
+  if (strcmp(str, "epsilon") == 0) return (void *) epsilon;
+  if (strcmp(str, "sigma") == 0) return (void *) sigma;
+
+  dim = 0;
+  if (strcmp(str, "ewald_mix") == 0) return (void *) &mix_flag;
+  if (strcmp(str, "cut_vdwl") == 0) return (void *) &cut_lj_global;
+  return PairLJCutCoulEsp::extract(str, dim);
+}
