+
+/* ---------------------------------------------------------------------- */
+
+PairLJLongTIP4PEsp::PairLJLongTIP4PEsp(LAMMPS *lmp) : PairLJCutTIP4PEsp(lmp)
+{
+  dispersionflag = 1;
+  respa_enable = 1;
+}
+
+/* ---------------------------------------------------------------------- */
+
+void PairLJLongTIP4PEsp::settings(int narg, char **arg)
+{
+  if (narg < 8 || narg > 9 || strcmp(arg[0], "long") != 0 || strcmp(arg[1], "long") != 0)
+    error->all(FLERR, "Illegal pair_style command");
+
+  PairLJCutTIP4PEsp::settings(narg - 2, arg + 2);
+}
+
+/* ---------------------------------------------------------------------- */
+
+void PairLJLongTIP4PEsp::init_style()
+{
+  PairLJCutTIP4PEsp::init_style();
+
+  auto *solver = dynamic_cast<ESPDispTIP4P *>(force->kspace);
+  if (!solver)
+    error->all(FLERR,
+               "Pair style lj/long/tip4p/esp requires "
+               "kspace style esp/disp/tip4p");
+  if (offset_flag) error->all(FLERR, "Cannot use pair_modify shift with lj/long/tip4p/esp");
+  if (tail_flag) error->all(FLERR, "Cannot use pair_modify tail with lj/long/tip4p/esp");
+
+  solver->dispersion_pair_coeffs(disp_force_poly, disp_force_order, disp_energy_poly,
+                                 disp_energy_order);
+}
+
+/* ---------------------------------------------------------------------- */
+
+double PairLJLongTIP4PEsp::init_one(int i, int j)
+{
+  const double cut = PairLJCutTIP4PEsp::init_one(i, j);
+  if (cut_lj[i][j] != 0.0 && std::abs(cut_lj[i][j] - cut_lj_global) > 1.0e-12)
+    error->all(FLERR, "Pair style lj/long/tip4p/esp requires one global LJ cutoff");
+  return cut;
+}
+
+/* ---------------------------------------------------------------------- */
+
+void PairLJLongTIP4PEsp::compute_inner()
+{
+  compute_respa_level(0);
+}
+
+/* ---------------------------------------------------------------------- */
+
+void PairLJLongTIP4PEsp::compute_middle()
+{
+  compute_respa_level(1);
+}
+
+/* ---------------------------------------------------------------------- */
+
+void PairLJLongTIP4PEsp::compute_outer(int eflag, int vflag)
+{
+  PairLJCutTIP4PEsp::compute(eflag, vflag);
+  compute_respa_level(2);
+}
+
+/* ---------------------------------------------------------------------- */
+
+void PairLJLongTIP4PEsp::compute_respa_level(int level)
+{
+  if (!cut_respa) return;
+
+  int inum;
+  int *ilist, *numneigh, **firstneigh;
+  if (level == 0) {
+    inum = list->inum_inner;
+    ilist = list->ilist_inner;
+    numneigh = list->numneigh_inner;
+    firstneigh = list->firstneigh_inner;
+  } else if (level == 1) {
+    inum = list->inum_middle;
+    ilist = list->ilist_middle;
+    numneigh = list->numneigh_middle;
+    firstneigh = list->firstneigh_middle;
+  } else {
+    inum = list->inum;
+    ilist = list->ilist;
+    numneigh = list->numneigh;
+    firstneigh = list->firstneigh;
+  }
+
+  auto respa_weight = [this, level](double rsq) {
+    if (level == 0) {
+      const double cut_on = cut_respa[0];
+      const double cut_off = cut_respa[1];
+      if (rsq >= cut_off * cut_off) return 0.0;
+      if (rsq <= cut_on * cut_on) return 1.0;
+      const double s = (std::sqrt(rsq) - cut_on) / (cut_off - cut_on);
+      return 1.0 + s * s * (2.0 * s - 3.0);
+    }
+
+    if (level == 1) {
+      const double cut_in_off = cut_respa[0];
+      const double cut_in_on = cut_respa[1];
+      const double cut_out_on = cut_respa[2];
+      const double cut_out_off = cut_respa[3];
+      if (rsq <= cut_in_off * cut_in_off || rsq >= cut_out_off * cut_out_off) return 0.0;
+      double weight = 1.0;
+      if (rsq < cut_in_on * cut_in_on) {
+        const double s = (std::sqrt(rsq) - cut_in_off) / (cut_in_on - cut_in_off);
+        weight *= s * s * (3.0 - 2.0 * s);
+      }
+      if (rsq > cut_out_on * cut_out_on) {
+        const double s = (std::sqrt(rsq) - cut_out_on) / (cut_out_off - cut_out_on);
+        weight *= 1.0 + s * s * (2.0 * s - 3.0);
+      }
+      return weight;
+    }
+
+    const double cut_off = cut_respa[2];
+    const double cut_on = cut_respa[3];
+    if (rsq >= cut_on * cut_on) return 0.0;
+    if (rsq <= cut_off * cut_off) return -1.0;
+    const double s = (std::sqrt(rsq) - cut_off) / (cut_on - cut_off);
+    return -(1.0 - s * s * (3.0 - 2.0 * s));
+  };
+
+  const int nall = atom->nlocal + atom->nghost;
+  if (atom->nmax > nmax) {
+    nmax = atom->nmax;
+    memory->destroy(hneigh);
+    memory->create(hneigh, nmax, 3, "pair:hneigh");
+    memory->destroy(newsite);
+    memory->create(newsite, nmax, 3, "pair:newsite");
+  }
+  if (neighbor->ago == 0)
+    for (int i = 0; i < nall; i++) hneigh[i][0] = -1;
+  for (int i = 0; i < nall; i++) hneigh[i][2] = 0;
+
+  double **x = atom->x;
+  double **f = atom->f;
+  double *q = atom->q;
+  tagint *tag = atom->tag;
+  int *type = atom->type;
+  double *special_coul = force->special_coul;
+  double *special_lj = force->special_lj;
+  const double cut_coulsqplus = (cut_coul + 2.0 * qdist) * (cut_coul + 2.0 * qdist);
+
+  auto charge_site = [&](int index, int &h1, int &h2) -> double * {
+    if (type[index] != typeO) {
+      h1 = h2 = -1;
+      return x[index];
+    }
+    if (hneigh[index][0] < 0) {
+      h1 = atom->map(tag[index] + 1);
+      h2 = atom->map(tag[index] + 2);
+      if (h1 == -1 || h2 == -1) error->one(FLERR, "TIP4P hydrogen is missing");
+      if (type[h1] != typeH || type[h2] != typeH)
+        error->one(FLERR, "TIP4P hydrogen has incorrect atom type");
+      h1 = domain->closest_image(index, h1);
+      h2 = domain->closest_image(index, h2);
+      hneigh[index][0] = h1;
+      hneigh[index][1] = h2;
+    } else {
+      h1 = hneigh[index][0];
+      h2 = hneigh[index][1];
+    }
+    if (hneigh[index][2] == 0) {
+      compute_newsite(x[index], x[h1], x[h2], newsite[index]);
+      hneigh[index][2] = 1;
+    }
+    return newsite[index];
+  };
+
+  auto add_charge_force = [&](int index, int h1, int h2, double fx, double fy, double fz) {
+    if (type[index] != typeO) {
+      f[index][0] += fx;
+      f[index][1] += fy;
+      f[index][2] += fz;
+      return;
+    }
+    const double oxygen = 1.0 - alpha;
+    const double hydrogen = 0.5 * alpha;
+    f[index][0] += oxygen * fx;
+    f[index][1] += oxygen * fy;
+    f[index][2] += oxygen * fz;
+    f[h1][0] += hydrogen * fx;
+    f[h1][1] += hydrogen * fy;
+    f[h1][2] += hydrogen * fz;
+    f[h2][0] += hydrogen * fx;
+    f[h2][1] += hydrogen * fy;
+    f[h2][2] += hydrogen * fz;
+  };
+
+  for (int ii = 0; ii < inum; ii++) {
+    const int i = ilist[ii];
+    const int itype = type[i];
+    int iH1, iH2;
+    double *x1 = charge_site(i, iH1, iH2);
+    int *jlist = firstneigh[i];
+    const int jnum = numneigh[i];
+
+    for (int jj = 0; jj < jnum; jj++) {
+      int j = jlist[jj];
+      const int special = sbmask(j);
+      j &= NEIGHMASK;
+      const int jtype = type[j];
+
+      double delx = x[i][0] - x[j][0];
+      double dely = x[i][1] - x[j][1];
+      double delz = x[i][2] - x[j][2];
+      double rsq = delx * delx + dely * dely + delz * delz;
+
+      if (rsq < cut_ljsq[itype][jtype]) {
+        const double weight = respa_weight(rsq);
+        if (weight != 0.0) {
+          const double r2inv = 1.0 / rsq;
+          const double r6inv = r2inv * r2inv * r2inv;
+          const double force_lj =
+              special_lj[special] * r6inv * (lj1[itype][jtype] * r6inv - lj2[itype][jtype]);
+          const double fpair = weight * force_lj * r2inv;
+          f[i][0] += delx * fpair;
+          f[i][1] += dely * fpair;
+          f[i][2] += delz * fpair;
+          f[j][0] -= delx * fpair;
+          f[j][1] -= dely * fpair;
+          f[j][2] -= delz * fpair;
+        }
+      }
+
+      if (rsq >= cut_coulsqplus) continue;
+      int jH1, jH2;
+      double *x2 = charge_site(j, jH1, jH2);
+      delx = x1[0] - x2[0];
+      dely = x1[1] - x2[1];
+      delz = x1[2] - x2[2];
+      rsq = delx * delx + dely * dely + delz * delz;
+      if (rsq >= cut_coulsq) continue;
+
+      const double weight = respa_weight(rsq);
+      if (weight == 0.0) continue;
+      const double r2inv = 1.0 / rsq;
+      const double force_coul =
+          force->qqrd2e * q[i] * q[j] * std::sqrt(r2inv) * special_coul[special];
+      const double cforce = weight * force_coul * r2inv;
+      add_charge_force(i, iH1, iH2, delx * cforce, dely * cforce, delz * cforce);
+      add_charge_force(j, jH1, jH2, -delx * cforce, -dely * cforce, -delz * cforce);
+    }
+  }
+}
+
+/* ---------------------------------------------------------------------- */
+
+void *PairLJLongTIP4PEsp::extract(const char *str, int &dim)
+{
+  dim = 2;
+  if (strcmp(str, "epsilon") == 0) return (void *) epsilon;
+  if (strcmp(str, "sigma") == 0) return (void *) sigma;
+
+  dim = 0;
+  if (strcmp(str, "ewald_mix") == 0) return (void *) &mix_flag;
+  if (strcmp(str, "cut_vdwl") == 0) return (void *) &cut_lj_global;
+  return PairLJCutTIP4PEsp::extract(str, dim);
+}
