+
+PairLJCutTIP4PEsp::PairLJCutTIP4PEsp(LAMMPS *lmp) :
+    PairLJCutCoulEsp(lmp), typeH(0), typeO(0), typeA(0), typeB(0), alpha(0.0), nmax(0),
+    hneigh(nullptr), newsite(nullptr)
+{
+  tip4pflag = 1;
+  espflag = 1;    // for clarity, though inherited from the parent class
+
+  single_enable = 0;
+  respa_enable = 0;
+  writedata = 1;
+
+  // TIP4P cannot compute virial as F dot r
+  // due to finding bonded H atoms which are not near O atom
+
+  no_virial_fdotr_compute = 1;
+}
