+/* ----------------------------------------------------------------------
+   return TIP4P per-atom contributions tallied on ghost H atoms to owners
+------------------------------------------------------------------------- */
+
+void ESP::reverse_tip4p_peratom()
+{
+  if (!evflag_atom || comm->nprocs == 1) return;
+
+  const int nlocal = atom->nlocal;
+  const int ntotal = nlocal + atom->nghost;
+  std::vector<TIP4PPeratomContribution> contributions;
+
+  for (int i = nlocal; i < ntotal; i++) {
+    bool nonzero = eflag_atom && eatom[i] != 0.0;
+    if (vflag_atom)
+      for (int j = 0; j < 6; j++)
+        nonzero |= vatom[i][j] != 0.0;
+    if (!nonzero) continue;
+
+    TIP4PPeratomContribution contribution{};
+    contribution.tag = atom->tag[i];
+    if (eflag_atom) {
+      contribution.energy = eatom[i];
+      eatom[i] = 0.0;
+    }
+    if (vflag_atom)
+      for (int j = 0; j < 6; j++) {
+        contribution.virial[j] = vatom[i][j];
+        vatom[i][j] = 0.0;
+      }
+    contributions.push_back(contribution);
+  }
+
+  TIP4PPeratomContext context{atom, eatom, vatom, eflag_atom, vflag_atom};
+  comm->ring(static_cast<int>(contributions.size()), sizeof(TIP4PPeratomContribution),
+             reinterpret_cast<char *>(contributions.data()), 1, unpack_tip4p_peratom, nullptr,
+             &context, 1);
+}
