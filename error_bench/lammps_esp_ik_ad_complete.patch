+/* ---------------------------------------------------------------------- */
+
+void ESPDisp::resize_grid_buffers(int count)
+{
+  if (count <= npergrid) return;
+  npergrid = count;
+  memory->destroy(gc_buf1);
+  memory->destroy(gc_buf2);
+  memory->create(gc_buf1, npergrid * ngc_buf1, "esp/disp:gc_buf1");
+  memory->create(gc_buf2, npergrid * ngc_buf2, "esp/disp:gc_buf2");
+}
+
+/* ---------------------------------------------------------------------- */
+
+void ESPDisp::allocate()
+{
+  ESP::allocate();
+
+  density_disp_brick.assign(ndisp_fields, nullptr);
+  field_disp_brick.assign(ndisp_fields, {});
+  u_disp_brick.assign(ndisp_fields, nullptr);
+  virial_disp_brick.assign(ndisp_fields, {});
+  density_disp_fft.assign(ndisp_fields, nullptr);
+  field_disp_atom.resize(ndisp_fields);
+  u_disp_atom.resize(ndisp_fields);
+  virial_disp_atom.resize(ndisp_fields);
+  scalar_disp_ptrs.resize(ndisp_fields);
+  vector_disp_ptrs.resize(ndisp_fields);
+  tensor_disp_ptrs.resize(ndisp_fields);
+  slab_moments_local.resize(ndisp_fields * DISP_SLAB_STRIDE);
+  slab_moments.resize(ndisp_fields * DISP_SLAB_STRIDE);
+  slab_polynomial.resize(ndisp_fields * DISP_SLAB_STRIDE);
+
+  for (int field = 0; field < ndisp_fields; field++) {
+    memory->create3d_offset(density_disp_brick[field], nzlo_out, nzhi_out, nylo_out, nyhi_out,
+                            nxlo_out, nxhi_out, "esp/disp:density_brick");
+    memory->create(density_disp_fft[field], nfft_both, "esp/disp:density_fft");
+
+    if (differentiation_flag == 1) {
+      memory->create3d_offset(u_disp_brick[field], nzlo_out, nzhi_out, nylo_out, nyhi_out, nxlo_out,
+                              nxhi_out, "esp/disp:u_brick");
+    } else {
+      for (int dim = 0; dim < 3; dim++)
+        memory->create3d_offset(field_disp_brick[field][dim], nzlo_out, nzhi_out, nylo_out,
+                                nyhi_out, nxlo_out, nxhi_out, "esp/disp:field_brick");
+    }
+  }
+
+  memory->create(greensfn_disp, nfft_both, "esp/disp:greensfn");
+  memory->create(greensfn2_disp, nfft_both, "esp/disp:greensfn2");
+  memory->create(vg_disp, nfft_both, 6, "esp/disp:vg");
+  memory->create(vg2_disp, nfft_both, 6, "esp/disp:vg2");
+
+  if (differentiation_flag == 1)
+    resize_grid_buffers(1 + ndisp_fields);
+  else
+    resize_grid_buffers(3 * (1 + ndisp_fields));
+
+  if (differentiation_flag == 1 && ndisp_fields == 1) {
+    remap_packed = new Remap(lmp, world, nxlo_in, nxhi_in, nylo_in, nyhi_in, nzlo_in, nzhi_in,
+                             nxlo_fft, nxhi_fft, nylo_fft, nyhi_fft, nzlo_fft, nzhi_fft, 2, 0, 0,
+                             FFT_PRECISION, collective_flag, nonblocking_flag);
+    setup_packed_fft();
+  }
+}
+
+/* ---------------------------------------------------------------------- */
+
+void ESPDisp::allocate_peratom()
+{
+  ESP::allocate_peratom();
+
+  for (int field = 0; field < ndisp_fields; field++) {
+    if (differentiation_flag != 1)
+      memory->create3d_offset(u_disp_brick[field], nzlo_out, nzhi_out, nylo_out, nyhi_out, nxlo_out,
+                              nxhi_out, "esp/disp:u_brick");
+    for (int component = 0; component < 6; component++)
+      memory->create3d_offset(virial_disp_brick[field][component], nzlo_out, nzhi_out, nylo_out,
+                              nyhi_out, nxlo_out, nxhi_out, "esp/disp:virial_brick");
+  }
+
+  resize_grid_buffers(std::max(npergrid, 7 * ndisp_fields));
+}
+
+/* ---------------------------------------------------------------------- */
+
+void ESPDisp::deallocate_dispersion_grid()
+{
+  delete remap_packed;
+  remap_packed = nullptr;
+  packed_send_counts.clear();
+  packed_send_displs.clear();
+  packed_recv_counts.clear();
+  packed_recv_displs.clear();
+  packed_send_indices.clear();
+  packed_recv_indices.clear();
+  packed_recv.clear();
+  packed_requests.clear();
+
+  for (std::size_t field = 0; field < density_disp_brick.size(); field++) {
+    if (density_disp_brick[field])
+      memory->destroy3d_offset(density_disp_brick[field], nzlo_out, nylo_out, nxlo_out);
+    if (differentiation_flag == 1) {
+      if (u_disp_brick[field])
+        memory->destroy3d_offset(u_disp_brick[field], nzlo_out, nylo_out, nxlo_out);
+    } else {
+      for (int dim = 0; dim < 3; dim++)
+        if (field_disp_brick[field][dim])
+          memory->destroy3d_offset(field_disp_brick[field][dim], nzlo_out, nylo_out, nxlo_out);
+    }
+    memory->destroy(density_disp_fft[field]);
+  }
+  memory->destroy(greensfn_disp);
+  memory->destroy(greensfn2_disp);
+  memory->destroy(vg_disp);
+  memory->destroy(vg2_disp);
+}
+
+void ESPDisp::deallocate()
+{
+  deallocate_dispersion_grid();
+  ESP::deallocate();
+}
+
+/* ---------------------------------------------------------------------- */
+
+void ESPDisp::deallocate_dispersion_peratom()
+{
+  for (std::size_t field = 0; field < virial_disp_brick.size(); field++) {
+    for (int component = 0; component < 6; component++)
+      if (virial_disp_brick[field][component])
+        memory->destroy3d_offset(virial_disp_brick[field][component], nzlo_out, nylo_out, nxlo_out);
+    if (differentiation_flag != 1 && u_disp_brick[field])
+      memory->destroy3d_offset(u_disp_brick[field], nzlo_out, nylo_out, nxlo_out);
+  }
+}
+
+void ESPDisp::deallocate_peratom()
+{
+  deallocate_dispersion_peratom();
+  ESP::deallocate_peratom();
+}
+
+/* ---------------------------------------------------------------------- */
+
+void ESPDisp::grow_dispersion_sites()
+{
+  if (atom->nmax <= nmax_disp) return;
+
+  nmax_disp = atom->nmax;
+  memory->destroy(part2grid_disp);
+  memory->destroy(disp_sites);
+  memory->create(part2grid_disp, nmax_disp, 3, "esp/disp:part2grid");
+  memory->create(disp_sites, nmax_disp, "esp/disp:sites");
+}
+
+/* ---------------------------------------------------------------------- */
+
+void ESPDisp::particle_map_dispersion()
+{
+  grow_dispersion_sites();
+
+  double **x = atom->x;
+  int *type = atom->type;
+  ndisp = 0;
+  int flag = 0;
+
+  for (int i = 0; i < atom->nlocal; i++) {
+    if (!has_dispersion_coefficient(type[i])) continue;
+    disp_sites[ndisp++] = i;
+
+    const int nx = static_cast<int>((x[i][0] - boxlo[0]) * delxinv + shift) - OFFSET;
+    const int ny = static_cast<int>((x[i][1] - boxlo[1]) * delyinv + shift) - OFFSET;
+    const int nz = static_cast<int>((x[i][2] - boxlo[2]) * delzinv + shift) - OFFSET;
+
+    part2grid_disp[i][0] = nx;
+    part2grid_disp[i][1] = ny;
+    part2grid_disp[i][2] = nz;
+
+    if (nx + nlower < nxlo_out || nx + nupper > nxhi_out || ny + nlower < nylo_out ||
+        ny + nupper > nyhi_out || nz + nlower < nzlo_out || nz + nupper > nzhi_out)
+      flag++;
+  }
+
+  int flag_all;
+  MPI_Allreduce(&flag, &flag_all, 1, MPI_INT, MPI_SUM, world);
+  if (flag_all)
+    error->all(FLERR, Error::NOLASTLINE,
+               "Out of range atoms - cannot compute ESP" + utils::errorurl(4));
+}
+
+/* ---------------------------------------------------------------------- */
+
+void ESPDisp::make_rho_dispersion()
+{
+  for (int field = 0; field < ndisp_fields; field++) {
+    FFT_SCALAR *density = &density_disp_brick[field][nzlo_out][nylo_out][nxlo_out];
+    for (int i = 0; i < ngrid; i++) density[i] = ZEROF;
+  }
+
+  double **x = atom->x;
+  int *type = atom->type;
+  int **grid = part2grid_disp;
+
+  for (int index = 0; index < ndisp; index++) {
+    const int i = disp_sites[index];
+    const int nx = grid[i][0];
+    const int ny = grid[i][1];
+    const int nz = grid[i][2];
+    const double *dispersion_coefficients = B + ndisp_fields * type[i];
+
+    const FFT_SCALAR dx = nx + shiftone - (x[i][0] - boxlo[0]) * delxinv;
+    const FFT_SCALAR dy = ny + shiftone - (x[i][1] - boxlo[1]) * delyinv;
+    const FFT_SCALAR dz = nz + shiftone - (x[i][2] - boxlo[2]) * delzinv;
+
+    compute_rho1d(dx, dy, dz);
+
+    const FFT_SCALAR zscale = delvolinv;
+    for (int n = nlower; n <= nupper; n++) {
+      const int mz = n + nz;
+      const FFT_SCALAR yscale = zscale * rho1d[2][n];
+      for (int m = nlower; m <= nupper; m++) {
+        const int my = m + ny;
+        const FFT_SCALAR xscale = yscale * rho1d[1][m];
+        for (int l = nlower; l <= nupper; l++) {
+          const FFT_SCALAR weight = xscale * rho1d[0][l];
+          for (int field = 0; field < ndisp_fields; field++)
+            density_disp_brick[field][mz][my][l + nx] += weight * dispersion_coefficients[field];
+        }
+      }
+    }
+  }
+}
+
+/* ----------------------------------------------------------------------
+   map charge and one dispersion structure factor in one stencil traversal
+------------------------------------------------------------------------- */
+
+void ESPDisp::make_rho_geometric_ad()
+{
+  FFT_SCALAR *coul = &density_brick[nzlo_out][nylo_out][nxlo_out];
+  FFT_SCALAR *disp = &density_disp_brick[0][nzlo_out][nylo_out][nxlo_out];
+  for (int i = 0; i < ngrid; i++) coul[i] = disp[i] = ZEROF;
+
+  double *q = atom->q;
+  double **x = atom->x;
+  int *type = atom->type;
+
+  for (int i = 0; i < atom->nlocal; i++) {
+    const int nx = part2grid[i][0];
+    const int ny = part2grid[i][1];
+    const int nz = part2grid[i][2];
+    const FFT_SCALAR dx = nx + shiftone - (x[i][0] - boxlo[0]) * delxinv;
+    const FFT_SCALAR dy = ny + shiftone - (x[i][1] - boxlo[1]) * delyinv;
+    const FFT_SCALAR dz = nz + shiftone - (x[i][2] - boxlo[2]) * delzinv;
+
+    compute_rho1d(dx, dy, dz);
+
+    const FFT_SCALAR qscale = delvolinv * q[i];
+    const FFT_SCALAR bscale = delvolinv * dispersion_coefficient(type[i], 0);
+    if (bscale == ZEROF) {
+      for (int n = nlower; n <= nupper; n++) {
+        const int mz = n + nz;
+        const FFT_SCALAR z0 = rho1d[2][n];
+        for (int m = nlower; m <= nupper; m++) {
+          const int my = m + ny;
+          const FFT_SCALAR yz = z0 * rho1d[1][m];
+          FFT_SCALAR *crow = &density_brick[mz][my][nx + nlower];
+          for (int l = nlower; l <= nupper; l++) crow[l - nlower] += qscale * yz * rho1d[0][l];
+        }
+      }
+    } else {
+      for (int n = nlower; n <= nupper; n++) {
+        const int mz = n + nz;
+        const FFT_SCALAR z0 = rho1d[2][n];
+        for (int m = nlower; m <= nupper; m++) {
+          const int my = m + ny;
+          const FFT_SCALAR yz = z0 * rho1d[1][m];
+          FFT_SCALAR *crow = &density_brick[mz][my][nx + nlower];
+          FFT_SCALAR *drow = &density_disp_brick[0][mz][my][nx + nlower];
+          for (int l = nlower; l <= nupper; l++) {
+            const FFT_SCALAR weight = yz * rho1d[0][l];
+            const int offset = l - nlower;
+            crow[offset] += qscale * weight;
+            drow[offset] += bscale * weight;
+          }
+        }
+      }
+    }
+  }
+}
+
+/* ---------------------------------------------------------------------- */
+
+void ESPDisp::brick2fft_dispersion(int field)
+{
+  std::swap(density_brick, density_disp_brick[field]);
+  std::swap(density_fft, density_disp_fft[field]);
+  ESP::brick2fft();
+  std::swap(density_fft, density_disp_fft[field]);
+  std::swap(density_brick, density_disp_brick[field]);
+}
+
+/* ----------------------------------------------------------------------
+   precompute the exchange that maps Z(k) to Z(-k) in the FFT layout
+------------------------------------------------------------------------- */
+
+void ESPDisp::setup_packed_fft()
+{
+  int bounds[4] = {nylo_fft, nyhi_fft, nzlo_fft, nzhi_fft};
+  std::vector<int> all_bounds(4 * nprocs);
+  MPI_Allgather(bounds, 4, MPI_INT, all_bounds.data(), 4, MPI_INT, world);
+
+  std::vector<int> owner(ny_pppm * nz_pppm, -1);
+  for (int iproc = 0; iproc < nprocs; iproc++) {
+    const int ylo = all_bounds[4 * iproc];
+    const int yhi = all_bounds[4 * iproc + 1];
+    const int zlo = all_bounds[4 * iproc + 2];
+    const int zhi = all_bounds[4 * iproc + 3];
+    for (int k = zlo; k <= zhi; k++)
+      for (int j = ylo; j <= yhi; j++) owner[k * ny_pppm + j] = iproc;
+  }
+  if (std::find(owner.begin(), owner.end(), -1) != owner.end())
+    error->all(FLERR, "Could not construct ESP packed FFT exchange");
+
+  std::vector<int> send_counts(nprocs, 0);
+  for (int k = nzlo_fft; k <= nzhi_fft; k++) {
+    const int kc = (nz_pppm - k) % nz_pppm;
+    for (int j = nylo_fft; j <= nyhi_fft; j++) {
+      const int jc = (ny_pppm - j) % ny_pppm;
+      const int dest = owner[kc * ny_pppm + jc];
+      send_counts[dest] += nx_pppm;
+    }
+  }
+
+  std::vector<int> send_displs(nprocs, 0);
+  for (int iproc = 1; iproc < nprocs; iproc++)
+    send_displs[iproc] = send_displs[iproc - 1] + send_counts[iproc - 1];
+
+  packed_send_indices.resize(nfft);
+  std::vector<int> send_dest_indices(nfft);
+  std::vector<int> cursor = send_displs;
+  int source = 0;
+  for (int k = nzlo_fft; k <= nzhi_fft; k++) {
+    const int kc = (nz_pppm - k) % nz_pppm;
+    for (int j = nylo_fft; j <= nyhi_fft; j++) {
+      const int jc = (ny_pppm - j) % ny_pppm;
+      const int dest = owner[kc * ny_pppm + jc];
+      const int dest_ylo = all_bounds[4 * dest];
+      const int dest_ysize = all_bounds[4 * dest + 1] - dest_ylo + 1;
+      const int dest_zlo = all_bounds[4 * dest + 2];
+      for (int i = 0; i < nx_pppm; i++) {
+        const int ic = (nx_pppm - i) % nx_pppm;
+        const int position = cursor[dest]++;
+        packed_send_indices[position] = source++;
+        send_dest_indices[position] = ((kc - dest_zlo) * dest_ysize + jc - dest_ylo) * nx_pppm + ic;
+      }
+    }
+  }
+
+  std::vector<int> recv_counts(nprocs);
+  MPI_Alltoall(send_counts.data(), 1, MPI_INT, recv_counts.data(), 1, MPI_INT, world);
+  std::vector<int> recv_displs(nprocs, 0);
+  for (int iproc = 1; iproc < nprocs; iproc++)
+    recv_displs[iproc] = recv_displs[iproc - 1] + recv_counts[iproc - 1];
+
+  const int nrecv = recv_displs.back() + recv_counts.back();
+  if (source != nfft || nrecv != nfft)
+    error->all(FLERR, "Inconsistent ESP packed FFT exchange size");
+  if (send_counts[me] != recv_counts[me])
+    error->all(FLERR, "Inconsistent ESP packed FFT self exchange");
+
+  packed_recv_indices.resize(nrecv);
+  MPI_Alltoallv(send_dest_indices.data(), send_counts.data(), send_displs.data(), MPI_INT,
+                packed_recv_indices.data(), recv_counts.data(), recv_displs.data(), MPI_INT, world);
+
+  std::vector<char> seen(nfft, 0);
+  for (const int index : packed_recv_indices) {
+    if (index < 0 || index >= nfft || seen[index])
+      error->all(FLERR, "Invalid ESP packed FFT exchange map");
+    seen[index] = 1;
+  }
+
+  packed_send_counts.resize(nprocs);
+  packed_send_displs.resize(nprocs);
+  packed_recv_counts.resize(nprocs);
+  packed_recv_displs.resize(nprocs);
+  for (int iproc = 0; iproc < nprocs; iproc++) {
+    packed_send_counts[iproc] = 2 * send_counts[iproc];
+    packed_send_displs[iproc] = 2 * send_displs[iproc];
+    packed_recv_counts[iproc] = 2 * recv_counts[iproc];
+    packed_recv_displs[iproc] = 2 * recv_displs[iproc];
+  }
+  packed_recv.resize(2 * nrecv);
+  packed_requests.resize(2 * nprocs);
+}
+
+/* ----------------------------------------------------------------------
+   remap charge and dispersion densities as one complex FFT input
+------------------------------------------------------------------------- */
+
+void ESPDisp::brick2fft_packed()
+{
+  const double dispersion_norm = std::abs(bsqsum);
+  packed_dispersion_scale = 1.0;
+  if (qsqsum > 0.0 && dispersion_norm > 0.0) {
+    const double scale_candidate = std::sqrt(qsqsum / dispersion_norm);
+    if (std::isfinite(scale_candidate) && scale_candidate > 0.0)
+      packed_dispersion_scale = scale_candidate;
+  }
+
+  int n = 0;
+  for (int k = nzlo_in; k <= nzhi_in; k++)
+    for (int j = nylo_in; j <= nyhi_in; j++)
+      for (int i = nxlo_in; i <= nxhi_in; i++) {
+        work1[n++] = density_brick[k][j][i];
+        work1[n++] = packed_dispersion_scale * density_disp_brick[0][k][j][i];
+      }
+
+  remap_packed->perform(work1, work1, work2);
+}
+
+/* ----------------------------------------------------------------------
+   exchange packed FFT values so each rank owns conjugate Z(-k)
+------------------------------------------------------------------------- */
+
+void ESPDisp::exchange_packed_fft()
+{
+  for (int i = 0; i < nfft; i++) {
+    const int source = packed_send_indices[i];
+    work2[2 * i] = work1[2 * source];
+    work2[2 * i + 1] = work1[2 * source + 1];
+  }
+
+  if (collective_flag) {
+    const bool self_copy = collective_flag == 2 || (collective_flag == 3 && nprocs == 1);
+    if (self_copy) {
+      const int self_count = packed_send_counts[me];
+      packed_send_counts[me] = packed_recv_counts[me] = 0;
+      if (nprocs > 1)
+        MPI_Alltoallv(work2, packed_send_counts.data(), packed_send_displs.data(), MPI_FFT_SCALAR,
+                      packed_recv.data(), packed_recv_counts.data(), packed_recv_displs.data(),
+                      MPI_FFT_SCALAR, world);
+      packed_send_counts[me] = packed_recv_counts[me] = self_count;
+      if (self_count)
+        std::copy_n(work2 + packed_send_displs[me], self_count,
+                    packed_recv.data() + packed_recv_displs[me]);
+    } else {
+      MPI_Alltoallv(work2, packed_send_counts.data(), packed_send_displs.data(), MPI_FFT_SCALAR,
+                    packed_recv.data(), packed_recv_counts.data(), packed_recv_displs.data(),
+                    MPI_FFT_SCALAR, world);
+    }
+    return;
+  }
+
+  int nrequest = 0;
+  for (int iproc = 0; iproc < nprocs; iproc++) {
+    if (iproc == me || packed_recv_counts[iproc] == 0) continue;
+    MPI_Irecv(packed_recv.data() + packed_recv_displs[iproc], packed_recv_counts[iproc],
+              MPI_FFT_SCALAR, iproc, 0, world, &packed_requests[nrequest++]);
+  }
+  for (int iproc = 0; iproc < nprocs; iproc++) {
+    if (iproc == me || packed_send_counts[iproc] == 0) continue;
+    MPI_Isend(work2 + packed_send_displs[iproc], packed_send_counts[iproc], MPI_FFT_SCALAR, iproc,
+              0, world, &packed_requests[nrequest++]);
+  }
+
+  if (packed_recv_counts[me])
+    std::copy_n(work2 + packed_send_displs[me], packed_recv_counts[me],
+                packed_recv.data() + packed_recv_displs[me]);
+  if (nrequest) MPI_Waitall(nrequest, packed_requests.data(), MPI_STATUS_IGNORE);
+}
+
+/* ----------------------------------------------------------------------
+   solve charge and one dispersion field with one forward/backward FFT pair
+------------------------------------------------------------------------- */
+
+void ESPDisp::poisson_geometric_ad(double &energy_coul, double *virial_coul, double &energy_disp,
+                                   double *virial_disp)
+{
+  energy_coul = energy_disp = 0.0;
+  for (int component = 0; component < 6; component++)
+    virial_coul[component] = virial_disp[component] = 0.0;
+
+  fft1->compute(work1, work1, FFT3d::FORWARD);
+  exchange_packed_fft();
+
+  const bigint ngridtotal = (bigint) nx_pppm * ny_pppm * nz_pppm;
+  const double scaleinv = 1.0 / ngridtotal;
+  const double s2 = scaleinv * scaleinv;
+  const double mode_weight = dispersion_weight[0];
+  const double inv_dispersion_scale = 1.0 / packed_dispersion_scale;
+
+  // For z(x) = rho_c(x) + i rho_d(x), recover both real-field spectra
+  // from Z(k) and conj(Z(-k)), apply their distinct kernels, and repack.
+
+  for (int entry = 0; entry < nfft; entry++) {
+    const int i = packed_recv_indices[entry];
+    const double zr = work1[2 * i];
+    const double zi = work1[2 * i + 1];
+    const double cr = packed_recv[2 * entry];
+    const double ci = -packed_recv[2 * entry + 1];
+
+    const double ar = 0.5 * (zr + cr);
+    const double ai = 0.5 * (zi + ci);
+    const double br = 0.5 * (zi - ci) * inv_dispersion_scale;
+    const double bi = 0.5 * (cr - zr) * inv_dispersion_scale;
+
+    if (eflag_global || vflag_global) {
+      const double norm_coul = ar * ar + ai * ai;
+      const double norm_disp = br * br + bi * bi;
+      const double eng_coul = s2 * greensfn[i] * norm_coul;
+      const double eng_disp = mode_weight * s2 * greensfn_disp[i] * norm_disp;
+      if (eflag_global) {
+        energy_coul += eng_coul;
+        energy_disp += eng_disp;
+      }
+      if (vflag_global)
+        for (int component = 0; component < 6; component++) {
+          virial_coul[component] +=
+              eng_coul * vg[i][component] + s2 * greensfn2[i] * norm_coul * vg2[i][component];
+          virial_disp[component] += eng_disp * vg_disp[i][component] +
+              mode_weight * s2 * greensfn2_disp[i] * norm_disp * vg2_disp[i][component];
+        }
+    }
+
+    const double gcoul = scaleinv * greensfn[i];
+    const double gdisp = scaleinv * greensfn_disp[i];
+    work2[2 * i] = gcoul * ar - gdisp * bi;
+    work2[2 * i + 1] = gcoul * ai + gdisp * br;
+  }
+
+  fft2->compute(work2, work2, FFT3d::BACKWARD);
+
+  int n = 0;
+  for (int k = nzlo_in; k <= nzhi_in; k++)
+    for (int j = nylo_in; j <= nyhi_in; j++)
+      for (int i = nxlo_in; i <= nxhi_in; i++) {
+        u_brick[k][j][i] = work2[n++];
+        u_disp_brick[0][k][j][i] = work2[n++];
+      }
+}
+
+/* ---------------------------------------------------------------------- */
+
+void ESPDisp::poisson_dispersion_channel(int field)
+{
+  const double energy_before = energy;
+  double virial_before[6];
+  for (int component = 0; component < 6; component++) virial_before[component] = virial[component];
+
+  std::swap(density_fft, density_disp_fft[field]);
+  std::swap(greensfn, greensfn_disp);
+  std::swap(greensfn2, greensfn2_disp);
+  std::swap(vg, vg_disp);
+  std::swap(vg2, vg2_disp);
+  std::swap(vdx_brick, field_disp_brick[field][0]);
+  std::swap(vdy_brick, field_disp_brick[field][1]);
+  std::swap(vdz_brick, field_disp_brick[field][2]);
+  std::swap(u_brick, u_disp_brick[field]);
+  std::swap(v0_brick, virial_disp_brick[field][0]);
+  std::swap(v1_brick, virial_disp_brick[field][1]);
+  std::swap(v2_brick, virial_disp_brick[field][2]);
+  std::swap(v3_brick, virial_disp_brick[field][3]);
+  std::swap(v4_brick, virial_disp_brick[field][4]);
+  std::swap(v5_brick, virial_disp_brick[field][5]);
+
+  ESP::poisson();
+
+  const double weight = dispersion_weight[field];
+  if (eflag_global) energy = energy_before + weight * (energy - energy_before);
+  if (vflag_global)
+    for (int component = 0; component < 6; component++)
+      virial[component] =
+          virial_before[component] + weight * (virial[component] - virial_before[component]);
+
+  std::swap(v5_brick, virial_disp_brick[field][5]);
+  std::swap(v4_brick, virial_disp_brick[field][4]);
+  std::swap(v3_brick, virial_disp_brick[field][3]);
+  std::swap(v2_brick, virial_disp_brick[field][2]);
+  std::swap(v1_brick, virial_disp_brick[field][1]);
+  std::swap(v0_brick, virial_disp_brick[field][0]);
+  std::swap(u_brick, u_disp_brick[field]);
+  std::swap(vdz_brick, field_disp_brick[field][2]);
+  std::swap(vdy_brick, field_disp_brick[field][1]);
+  std::swap(vdx_brick, field_disp_brick[field][0]);
+  std::swap(vg2, vg2_disp);
+  std::swap(vg, vg_disp);
+  std::swap(greensfn2, greensfn2_disp);
+  std::swap(greensfn, greensfn_disp);
+  std::swap(density_fft, density_disp_fft[field]);
+}
+
+/* ---------------------------------------------------------------------- */
+
+void ESPDisp::poisson_dispersion()
+{
+  int field = 0;
+  for (; field + 1 < ndisp_fields; field += 2) poisson_dispersion_pair(field, field + 1);
+  if (field < ndisp_fields) poisson_dispersion_channel(field);
+}
+
+/* ----------------------------------------------------------------------
+   inverse-transform the per-atom virial fields for two packed densities
+------------------------------------------------------------------------- */
+
+void ESPDisp::poisson_dispersion_pair_peratom(int field1, int field2)
+{
+  for (int component = 0; component < 6; component++) {
+    int n = 0;
+    for (int i = 0; i < nfft; i++) {
+      double coefficient = vg_disp[i][component];
+      if (differentiation_flag == 1 && greensfn_disp[i] != 0.0)
+        coefficient += greensfn2_disp[i] / greensfn_disp[i] * vg2_disp[i][component];
+      work2[n] = work1[n] * coefficient;
+      work2[n + 1] = work1[n + 1] * coefficient;
+      n += 2;
+    }
+
+    fft2->compute(work2, work2, FFT3d::BACKWARD);
+
+    n = 0;
+    for (int k = nzlo_in; k <= nzhi_in; k++)
+      for (int j = nylo_in; j <= nyhi_in; j++)
+        for (int i = nxlo_in; i <= nxhi_in; i++) {
+          virial_disp_brick[field1][component][k][j][i] = work2[n++];
+          virial_disp_brick[field2][component][k][j][i] = -work2[n++];
+        }
+  }
+}
+
+/* ----------------------------------------------------------------------
+   solve two independent dispersion modes packed into one complex FFT
+------------------------------------------------------------------------- */
+
+void ESPDisp::poisson_dispersion_pair(int field1, int field2)
+{
+  if (triclinic && differentiation_flag == 0) {
+    poisson_dispersion_pair_triclinic(field1, field2);
+    return;
+  }
+
+  const bigint ngridtotal = (bigint) nx_pppm * ny_pppm * nz_pppm;
+  const double scaleinv = 1.0 / ngridtotal;
+  const double s2 = scaleinv * scaleinv;
+  const double weight1 = dispersion_weight[field1];
+  const double weight2 = dispersion_weight[field2];
+
+  int n = 0;
+  if (!eflag_global && !vflag_global) {
+    for (int i = 0; i < nfft; i++) {
+      work1[n++] = density_disp_fft[field1][i];
+      work1[n++] = -density_disp_fft[field2][i];
+    }
+    fft1->compute(work1, work1, FFT3d::FORWARD);
+  } else {
+    for (int i = 0; i < nfft; i++) {
+      work1[n] = density_disp_fft[field1][i];
+      work2[n++] = ZEROF;
+      work1[n] = ZEROF;
+      work2[n++] = -density_disp_fft[field2][i];
+    }
+
+    fft1->compute(work1, work1, FFT3d::FORWARD);
+    fft1->compute(work2, work2, FFT3d::FORWARD);
+
+    n = 0;
+    for (int i = 0; i < nfft; i++) {
+      const double norm1 = work1[n] * work1[n] + work1[n + 1] * work1[n + 1];
+      const double norm2 = work2[n] * work2[n] + work2[n + 1] * work2[n + 1];
+      const double weighted_norm = s2 * (weight1 * norm1 + weight2 * norm2);
+      if (eflag_global) energy += weighted_norm * greensfn_disp[i];
+      if (vflag_global)
+        for (int component = 0; component < 6; component++) {
+          virial[component] += weighted_norm * greensfn_disp[i] * vg_disp[i][component];
+          if (differentiation_flag == 1)
+            virial[component] += weighted_norm * greensfn2_disp[i] * vg2_disp[i][component];
+        }
+      n += 2;
+    }
+
+    for (int i = 0; i < 2 * nfft; i++) work1[i] += work2[i];
+  }
+
+  n = 0;
+  for (int i = 0; i < nfft; i++) {
+    work1[n++] *= scaleinv * greensfn_disp[i];
+    work1[n++] *= scaleinv * greensfn_disp[i];
+  }
+
+  if (differentiation_flag == 1) {
+    for (int i = 0; i < 2 * nfft; i++) work2[i] = work1[i];
+    fft2->compute(work2, work2, FFT3d::BACKWARD);
+
+    n = 0;
+    for (int k = nzlo_in; k <= nzhi_in; k++)
+      for (int j = nylo_in; j <= nyhi_in; j++)
+        for (int i = nxlo_in; i <= nxhi_in; i++) {
+          u_disp_brick[field1][k][j][i] = work2[n++];
+          u_disp_brick[field2][k][j][i] = -work2[n++];
+        }
+  } else {
+    const double unitk[3] = {MY_2PI / domain->xprd, MY_2PI / domain->yprd,
+                             MY_2PI / (domain->zprd * slab_volfactor)};
+    const int nmesh[3] = {nx_pppm, ny_pppm, nz_pppm};
+
+    for (int dim = 0; dim < 3; dim++) {
+      n = 0;
+      for (int k = nzlo_fft; k <= nzhi_fft; k++)
+        for (int j = nylo_fft; j <= nyhi_fft; j++)
+          for (int i = nxlo_fft; i <= nxhi_fft; i++) {
+            const int index = dim == 0 ? i : (dim == 1 ? j : k);
+            const int conjugate = (nmesh[dim] - index) % nmesh[dim];
+            const int periodic = conjugate - nmesh[dim] * (2 * conjugate / nmesh[dim]);
+            const double kval = dim == 0 ? fkx[i] : (dim == 1 ? fky[j] : fkz[k]);
+            const double packed_k = 0.5 * (kval - unitk[dim] * periodic);
+            work2[n] = -packed_k * work1[n + 1];
+            work2[n + 1] = packed_k * work1[n];
+            n += 2;
+          }
+
+      fft2->compute(work2, work2, FFT3d::BACKWARD);
+
+      n = 0;
+      for (int k = nzlo_in; k <= nzhi_in; k++)
+        for (int j = nylo_in; j <= nyhi_in; j++)
+          for (int i = nxlo_in; i <= nxhi_in; i++) {
+            field_disp_brick[field1][dim][k][j][i] = work2[n++];
+            field_disp_brick[field2][dim][k][j][i] = -work2[n++];
+          }
+    }
+
+    if (eflag_atom) {
+      for (int i = 0; i < 2 * nfft; i++) work2[i] = work1[i];
+      fft2->compute(work2, work2, FFT3d::BACKWARD);
+      n = 0;
+      for (int k = nzlo_in; k <= nzhi_in; k++)
+        for (int j = nylo_in; j <= nyhi_in; j++)
+          for (int i = nxlo_in; i <= nxhi_in; i++) {
+            u_disp_brick[field1][k][j][i] = work2[n++];
+            u_disp_brick[field2][k][j][i] = -work2[n++];
+          }
+    }
+  }
+
+  if (vflag_atom) poisson_dispersion_pair_peratom(field1, field2);
+}
+
+/* ----------------------------------------------------------------------
+   finish one separately transformed density for triclinic IK
+------------------------------------------------------------------------- */
+
+void ESPDisp::poisson_dispersion_single_from_work(int field)
+{
+  const bigint ngridtotal = (bigint) nx_pppm * ny_pppm * nz_pppm;
+  const double scaleinv = 1.0 / ngridtotal;
+
+  int n = 0;
+  for (int i = 0; i < nfft; i++) {
+    work1[n++] *= scaleinv * greensfn_disp[i];
+    work1[n++] *= scaleinv * greensfn_disp[i];
+  }
+
+  for (int dim = 0; dim < 3; dim++) {
+    n = 0;
+    for (int i = 0; i < nfft; i++) {
+      const double kval = dim == 0 ? fkx[i] : (dim == 1 ? fky[i] : fkz[i]);
+      work2[n] = -kval * work1[n + 1];
+      work2[n + 1] = kval * work1[n];
+      n += 2;
+    }
+    fft2->compute(work2, work2, FFT3d::BACKWARD);
+
+    n = 0;
+    for (int k = nzlo_in; k <= nzhi_in; k++)
+      for (int j = nylo_in; j <= nyhi_in; j++)
+        for (int i = nxlo_in; i <= nxhi_in; i++) {
+          field_disp_brick[field][dim][k][j][i] = work2[n];
+          n += 2;
+        }
+  }
+
+  if (eflag_atom) {
+    for (int i = 0; i < 2 * nfft; i++) work2[i] = work1[i];
+    fft2->compute(work2, work2, FFT3d::BACKWARD);
+    n = 0;
+    for (int k = nzlo_in; k <= nzhi_in; k++)
+      for (int j = nylo_in; j <= nyhi_in; j++)
+        for (int i = nxlo_in; i <= nxhi_in; i++) {
+          u_disp_brick[field][k][j][i] = work2[n];
+          n += 2;
+        }
+  }
+
+  if (vflag_atom) {
+    for (int component = 0; component < 6; component++) {
+      n = 0;
+      for (int i = 0; i < nfft; i++) {
+        work2[n] = work1[n] * vg_disp[i][component];
+        work2[n + 1] = work1[n + 1] * vg_disp[i][component];
+        n += 2;
+      }
+      fft2->compute(work2, work2, FFT3d::BACKWARD);
+      n = 0;
+      for (int k = nzlo_in; k <= nzhi_in; k++)
+        for (int j = nylo_in; j <= nyhi_in; j++)
+          for (int i = nxlo_in; i <= nxhi_in; i++) {
+            virial_disp_brick[field][component][k][j][i] = work2[n];
+            n += 2;
+          }
+    }
+  }
+}
+
+/* ----------------------------------------------------------------------
+   triclinic IK fallback for two independent dispersion modes
+------------------------------------------------------------------------- */
+
+void ESPDisp::poisson_dispersion_pair_triclinic(int field1, int field2)
+{
+  const bigint ngridtotal = (bigint) nx_pppm * ny_pppm * nz_pppm;
+  const double scaleinv = 1.0 / ngridtotal;
+  const double s2 = scaleinv * scaleinv;
+
+  int n = 0;
+  for (int i = 0; i < nfft; i++) {
+    work1[n++] = density_disp_fft[field1][i];
+    work1[n++] = ZEROF;
+  }
+  fft1->compute(work1, work1, FFT3d::FORWARD);
+
+  if (eflag_global || vflag_global) {
+    n = 0;
+    for (int i = 0; i < nfft; i++) {
+      work2[n++] = density_disp_fft[field2][i];
+      work2[n++] = ZEROF;
+    }
+    fft1->compute(work2, work2, FFT3d::FORWARD);
+
+    n = 0;
+    for (int i = 0; i < nfft; i++) {
+      const double norm1 = work1[n] * work1[n] + work1[n + 1] * work1[n + 1];
+      const double norm2 = work2[n] * work2[n] + work2[n + 1] * work2[n + 1];
+      const double weighted_norm =
+          s2 * (dispersion_weight[field1] * norm1 + dispersion_weight[field2] * norm2);
+      if (eflag_global) energy += weighted_norm * greensfn_disp[i];
+      if (vflag_global)
+        for (int component = 0; component < 6; component++)
+          virial[component] += weighted_norm * greensfn_disp[i] * vg_disp[i][component];
+      n += 2;
+    }
+  }
+
+  poisson_dispersion_single_from_work(field1);
+
+  n = 0;
+  for (int i = 0; i < nfft; i++) {
+    work1[n++] = density_disp_fft[field2][i];
+    work1[n++] = ZEROF;
+  }
+  fft1->compute(work1, work1, FFT3d::FORWARD);
+  poisson_dispersion_single_from_work(field2);
+}
+
+/* ---------------------------------------------------------------------- */
+
+void ESPDisp::compute(int eflag, int vflag)
+{
+  ev_init(eflag, vflag);
+  if (evflag_atom && !peratom_allocate_flag) allocate_peratom();
+
+  if (atom->natoms != natoms_original) {
+    qsum_qsq();
+    dispersion_sum();
+    natoms_original = atom->natoms;
+  }
+
+  if (triclinic == 0)
+    boxlo = domain->boxlo;
+  else {
+    boxlo = domain->boxlo_lamda;
+    domain->x2lamda(atom->nlocal);
+  }
+
+  if (atom->nmax > nmax) {
+    memory->destroy(part2grid);
+    nmax = atom->nmax;
+    memory->create(part2grid, nmax, 3, "esp:part2grid");
+  }
+
+  const bool single_ad = ndisp_fields == 1 && differentiation_flag == 1 && !vflag_atom;
+
+  particle_map();
+  if (single_ad && !tip4pflag) {
+    if (eflag_atom) particle_map_dispersion();
+    make_rho_geometric_ad();
+  } else {
+    particle_map_dispersion();
+    make_rho();
+    make_rho_dispersion();
+  }
+
+  gc->reverse_comm(Grid3d::KSPACE, this, REVERSE_RHO_G, 1 + ndisp_fields, sizeof(FFT_SCALAR),
+                   gc_buf1, gc_buf2, MPI_FFT_SCALAR);
+
+  double local_energy_1 = 0.0;
+  double local_energy_6 = 0.0;
+  double local_virial_1[6] = {};
+  double local_virial_6[6] = {};
+  if (single_ad) {
+    brick2fft_packed();
+    poisson_geometric_ad(local_energy_1, local_virial_1, local_energy_6, local_virial_6);
+  } else {
+    ESP::brick2fft();
+    for (int field = 0; field < ndisp_fields; field++) brick2fft_dispersion(field);
+
+    energy = 0.0;
+    for (double &value : virial) value = 0.0;
+    ESP::poisson();
+    local_energy_1 = energy;
+    for (int i = 0; i < 6; i++) local_virial_1[i] = virial[i];
+
+    energy = 0.0;
+    for (double &value : virial) value = 0.0;
+    poisson_dispersion();
+    local_energy_6 = energy;
+    for (int i = 0; i < 6; i++) local_virial_6[i] = virial[i];
+  }
+
+  if (differentiation_flag == 1)
+    gc->forward_comm(Grid3d::KSPACE, this, FORWARD_AD_G, 1 + ndisp_fields, sizeof(FFT_SCALAR),
+                     gc_buf1, gc_buf2, MPI_FFT_SCALAR);
+  else
+    gc->forward_comm(Grid3d::KSPACE, this, FORWARD_IK_G, 3 * (1 + ndisp_fields), sizeof(FFT_SCALAR),
+                     gc_buf1, gc_buf2, MPI_FFT_SCALAR);
+
+  if (evflag_atom) {
+    if (differentiation_flag == 1 && vflag_atom) {
+      gc->forward_comm(Grid3d::KSPACE, this, FORWARD_AD_PERATOM, 6, sizeof(FFT_SCALAR), gc_buf1,
+                       gc_buf2, MPI_FFT_SCALAR);
+      gc->forward_comm(Grid3d::KSPACE, this, FORWARD_AD_PERATOM_G, 6 * ndisp_fields,
+                       sizeof(FFT_SCALAR), gc_buf1, gc_buf2, MPI_FFT_SCALAR);
+    } else if (differentiation_flag == 0) {
+      gc->forward_comm(Grid3d::KSPACE, this, FORWARD_IK_PERATOM, 7, sizeof(FFT_SCALAR), gc_buf1,
+                       gc_buf2, MPI_FFT_SCALAR);
+      gc->forward_comm(Grid3d::KSPACE, this, FORWARD_IK_PERATOM_G, 7 * ndisp_fields,
+                       sizeof(FFT_SCALAR), gc_buf1, gc_buf2, MPI_FFT_SCALAR);
+    }
+  }
+
+  if (differentiation_flag == 1) {
+    if (single_ad && !tip4pflag)
+      fieldforce_geometric_ad();
+    else {
+      fieldforce_ad();
+      if (single_ad)
+        fieldforce_dispersion_ad_single();
+      else
+        fieldforce_dispersion_ad();
+    }
+  } else {
+    fieldforce_ik();
+    fieldforce_dispersion_ik();
+  }
+
+  if (evflag_atom) fieldforce_peratom();
+
+  const double qscale = qqrd2e * scale;
+  energy_1 = energy_6 = 0.0;
+  if (eflag_global) {
+    MPI_Allreduce(&local_energy_1, &energy_1, 1, MPI_DOUBLE, MPI_SUM, world);
+    MPI_Allreduce(&local_energy_6, &energy_6, 1, MPI_DOUBLE, MPI_SUM, world);
+
+    double self_coeff = 0.0;
+    for (int i = 1; i < num_of_energy_poly; i++)
+      self_coeff += 2.0 * i * energy_poly_coeff[i] * (i % 2 ? 1.0 : -1.0);
+
+    energy_1 = (0.5 * volume * energy_1 - 0.5 * (-self_coeff / cutoff) * qsqsum) * qscale;
+    energy_6 = 0.5 * volume * energy_6 + 0.5 * self_disp * bsqsum;
+  }
+
+  if (vflag_global) {
+    double all_virial_1[6], all_virial_6[6];
+    MPI_Allreduce(local_virial_1, all_virial_1, 6, MPI_DOUBLE, MPI_SUM, world);
+    MPI_Allreduce(local_virial_6, all_virial_6, 6, MPI_DOUBLE, MPI_SUM, world);
+    for (int i = 0; i < 6; i++)
+      virial[i] = 0.5 * volume * (qscale * all_virial_1[i] + all_virial_6[i]);
+  } else {
+    for (double &value : virial) value = 0.0;
+  }
+
+  if (evflag_atom) {
+    double *q = atom->q;
+    int ntotal = atom->nlocal + atom->nghost;
+    if (eflag_atom) {
+      double self_coeff = 0.0;
+      for (int i = 1; i < num_of_energy_poly; i++)
+        self_coeff += 2.0 * i * energy_poly_coeff[i] * (i % 2 ? 1.0 : -1.0);
+      for (int i = 0; i < atom->nlocal; i++)
+        eatom[i] = (0.5 * eatom[i] - 0.5 * (-self_coeff / cutoff) * q[i] * q[i]) * qscale;
+      for (int i = atom->nlocal; i < ntotal; i++) eatom[i] *= 0.5 * qscale;
+    }
+    if (vflag_atom)
+      for (int i = 0; i < ntotal; i++)
+        for (int j = 0; j < 6; j++) vatom[i][j] *= 0.5 * qscale;
+
+    fieldforce_dispersion_peratom();
+  }
+
+  energy = energy_1 + energy_6;
+  if (slabflag == 1) {
+    slabcorr();
+    slabcorr_dispersion();
+  }
+  if (triclinic) domain->lamda2x(atom->nlocal);
+}
+
+/* ---------------------------------------------------------------------- */
+
+void ESPDisp::slabcorr_dispersion()
+{
+  // Remove the leading G = 0 contribution from periodically repeated
+  // dispersion slabs.  Each low-rank mode is evaluated from global
+  // one-particle z moments and multiplied by its signed factorization weight.
+
+  constexpr int max_order = DISP_SLAB_MAX_ORDER;
+  constexpr int degree = 2 * max_order;
+  const double zprd_slab = domain->zprd * slab_volfactor;
+  const double reduced_extent = 1.0 / slab_volfactor;
+  const double center = 0.5 * (domain->boxlo[2] + domain->boxhi[2]);
+
+  static const std::array<double, max_order + 1> kernel = [] {
+    std::array<double, max_order + 1> values{};
+    for (int m = 0; m <= max_order; m++) {
+      const double n = 2.0 * m;
+      const double choose = (n + 3.0) * (n + 2.0) * (n + 1.0) / 6.0;
+      values[m] = 2.0 * choose * zeta_even(2 * m + 4);
+    }
+    return values;
+  }();
+
+  if (reduced_extent > 0.0) {
+    const double last_force =
+        2.0 * max_order * kernel[max_order] * std::pow(reduced_extent, degree - 1);
+    if (last_force > 1.0e-10 * kernel[0])
+      error->all(FLERR, "Dispersion slab correction requires a larger slab volume factor");
+  }
+
+  constexpr int stride = DISP_SLAB_STRIDE;
+  std::fill(slab_moments_local.begin(), slab_moments_local.end(), 0.0);
+  int *type = atom->type;
+  for (int i = 0; i < atom->nlocal; i++) {
+    const double u = (atom->x[i][2] - center) / zprd_slab;
+    double upower = 1.0;
+    for (int p = 0; p <= degree; p++) {
+      for (int field = 0; field < ndisp_fields; field++)
+        slab_moments_local[field * stride + p] += dispersion_coefficient(type[i], field) * upower;
+      upower *= u;
+    }
+  }
+
+  MPI_Allreduce(slab_moments_local.data(), slab_moments.data(), ndisp_fields * stride, MPI_DOUBLE,
+                MPI_SUM, world);
+
+  std::fill(slab_polynomial.begin(), slab_polynomial.end(), 0.0);
+  for (int field = 0; field < ndisp_fields; field++) {
+    for (int m = 0; m <= max_order; m++) {
+      const int power = 2 * m;
+      double choose = 1.0;
+      for (int k = 0; k <= power; k++) {
+        const double sign = k % 2 ? -1.0 : 1.0;
+        slab_polynomial[field * stride + power - k] +=
+            kernel[m] * choose * sign * slab_moments[field * stride + k];
+        if (k < power) choose *= static_cast<double>(power - k) / (k + 1);
+      }
+    }
+  }
+
+  const double area = domain->xprd * domain->yprd;
+  const double prefactor = MY_PI / (4.0 * area * std::pow(zprd_slab, 4));
+  double energy_local = 0.0;
+  double **f = atom->f;
+  for (int i = 0; i < atom->nlocal; i++) {
+    const double u = (atom->x[i][2] - center) / zprd_slab;
+    double atom_energy = 0.0;
+    double atom_derivative = 0.0;
+    for (int field = 0; field < ndisp_fields; field++) {
+      const double *field_polynomial = slab_polynomial.data() + field * stride;
+      double potential = field_polynomial[degree];
+      double derivative = 0.0;
+      for (int p = degree - 1; p >= 0; p--) {
+        derivative = derivative * u + potential;
+        potential = potential * u + field_polynomial[p];
+      }
+      const double coefficient = weighted_dispersion_coefficient(type[i], field);
+      atom_energy += prefactor * coefficient * potential;
+      atom_derivative += coefficient * derivative;
+    }
+
+    energy_local += atom_energy;
+    f[i][2] -= 2.0 * prefactor / zprd_slab * atom_derivative;
+    if (eflag_atom) eatom[i] += atom_energy;
+  }
+
+  if (eflag_global || vflag_global) {
+    double energy_corr;
+    MPI_Allreduce(&energy_local, &energy_corr, 1, MPI_DOUBLE, MPI_SUM, world);
+    if (eflag_global) energy += energy_corr;
+    if (vflag_global) {
+      virial[0] += energy_corr;
+      virial[1] += energy_corr;
+      virial[2] += 4.0 * energy_corr;
+    }
+  }
+}
+
+/* ---------------------------------------------------------------------- */
+
+void ESPDisp::fieldforce_dispersion_ik()
+{
+  double **x = atom->x;
+  double **f = atom->f;
+  int *type = atom->type;
+  int **grid = part2grid_disp;
+
+  for (int index = 0; index < ndisp; index++) {
+    const int i = disp_sites[index];
+    const int nx = grid[i][0];
+    const int ny = grid[i][1];
+    const int nz = grid[i][2];
+    const FFT_SCALAR dx = nx + shiftone - (x[i][0] - boxlo[0]) * delxinv;
+    const FFT_SCALAR dy = ny + shiftone - (x[i][1] - boxlo[1]) * delyinv;
+    const FFT_SCALAR dz = nz + shiftone - (x[i][2] - boxlo[2]) * delzinv;
+
+    compute_rho1d(dx, dy, dz);
+
+    std::fill(field_disp_atom.begin(), field_disp_atom.end(), std::array<FFT_SCALAR, 3>{});
+    for (int n = nlower; n <= nupper; n++) {
+      const int mz = n + nz;
+      const FFT_SCALAR z0 = rho1d[2][n];
+      for (int m = nlower; m <= nupper; m++) {
+        const int my = m + ny;
+        const FFT_SCALAR y0 = z0 * rho1d[1][m];
+        for (int l = nlower; l <= nupper; l++) {
+          const int mx = l + nx;
+          const FFT_SCALAR weight = y0 * rho1d[0][l];
+          for (int field = 0; field < ndisp_fields; field++) {
+            field_disp_atom[field][0] -= weight * field_disp_brick[field][0][mz][my][mx];
+            field_disp_atom[field][1] -= weight * field_disp_brick[field][1][mz][my][mx];
+            field_disp_atom[field][2] -= weight * field_disp_brick[field][2][mz][my][mx];
+          }
+        }
+      }
+    }
+
+    double fdisp[3] = {0.0, 0.0, 0.0};
+    for (int field = 0; field < ndisp_fields; field++) {
+      const double coefficient = weighted_dispersion_coefficient(type[i], field);
+      for (int dim = 0; dim < 3; dim++) fdisp[dim] += coefficient * field_disp_atom[field][dim];
+    }
+    f[i][0] += fdisp[0];
+    f[i][1] += fdisp[1];
+    if (slabflag != 2) f[i][2] += fdisp[2];
+  }
+}
+
+/* ---------------------------------------------------------------------- */
+
+void ESPDisp::fieldforce_dispersion_ad()
+{
+  double *prd = triclinic ? domain->prd_lamda : domain->prd;
+  const double hx_inv = nx_pppm / prd[0];
+  const double hy_inv = ny_pppm / prd[1];
+  const double hz_inv = nz_pppm / (prd[2] * slab_volfactor);
+
+  double **x = atom->x;
+  double **f = atom->f;
+  int *type = atom->type;
+  int **grid = part2grid_disp;
+
+  for (int index = 0; index < ndisp; index++) {
+    const int i = disp_sites[index];
+    const int nx = grid[i][0];
+    const int ny = grid[i][1];
+    const int nz = grid[i][2];
+    const FFT_SCALAR dx = nx + shiftone - (x[i][0] - boxlo[0]) * delxinv;
+    const FFT_SCALAR dy = ny + shiftone - (x[i][1] - boxlo[1]) * delyinv;
+    const FFT_SCALAR dz = nz + shiftone - (x[i][2] - boxlo[2]) * delzinv;
+
+    compute_rho1d_and_drho1d(dx, dy, dz);
+
+    std::fill(field_disp_atom.begin(), field_disp_atom.end(), std::array<FFT_SCALAR, 3>{});
+    for (int n = nlower; n <= nupper; n++) {
+      const int mz = n + nz;
+      const FFT_SCALAR z0 = rho1d[2][n];
+      const FFT_SCALAR dz0 = drho1d[2][n];
+      for (int m = nlower; m <= nupper; m++) {
+        const int my = m + ny;
+        const FFT_SCALAR y0 = rho1d[1][m];
+        const FFT_SCALAR dy0 = drho1d[1][m];
+        for (int l = nlower; l <= nupper; l++) {
+          for (int field = 0; field < ndisp_fields; field++) {
+            const FFT_SCALAR u0 = u_disp_brick[field][mz][my][l + nx];
+            field_disp_atom[field][0] += drho1d[0][l] * y0 * z0 * u0;
+            field_disp_atom[field][1] += rho1d[0][l] * dy0 * z0 * u0;
+            field_disp_atom[field][2] += rho1d[0][l] * y0 * dz0 * u0;
+          }
+        }
+      }
+    }
+
+    double efield[3] = {0.0, 0.0, 0.0};
+    const double h_inv[3] = {hx_inv, hy_inv, hz_inv};
+    for (int dim = 0; dim < 3; dim++) {
+      for (int field = 0; field < ndisp_fields; field++) {
+        const double coefficient = weighted_dispersion_coefficient(type[i], field);
+        efield[dim] += coefficient * field_disp_atom[field][dim] * h_inv[dim];
+      }
+      const double theta = (x[i][dim] - (triclinic ? boxlo[dim] : 0.0)) * h_inv[dim] * MY_2PI;
+      const double sf =
+          (sf_coeff_disp[2 * dim] + 2.0 * sf_coeff_disp[2 * dim + 1] * std::cos(theta)) *
+          std::sin(theta);
+      efield[dim] -= 2.0 * dispersion_self_coefficient(type[i]) * sf;
+    }
+
+    if (triclinic) x2lamdaT(efield, efield);
+    f[i][0] += efield[0];
+    f[i][1] += efield[1];
+    if (slabflag != 2) f[i][2] += efield[2];
+  }
+}
+
+/* ----------------------------------------------------------------------
+   optimized AD interpolation for one dispersion structure factor
+------------------------------------------------------------------------- */
+
+void ESPDisp::fieldforce_dispersion_ad_single()
+{
+  double *prd = triclinic ? domain->prd_lamda : domain->prd;
+  const double h_inv[3] = {nx_pppm / prd[0], ny_pppm / prd[1], nz_pppm / (prd[2] * slab_volfactor)};
+
+  double **x = atom->x;
+  double **f = atom->f;
+  int *type = atom->type;
+  int **grid = part2grid_disp;
+  const double mode_weight = dispersion_weight[0];
+
+  for (int index = 0; index < ndisp; index++) {
+    const int i = disp_sites[index];
+    const int nx = grid[i][0];
+    const int ny = grid[i][1];
+    const int nz = grid[i][2];
+    const FFT_SCALAR dx = nx + shiftone - (x[i][0] - boxlo[0]) * delxinv;
+    const FFT_SCALAR dy = ny + shiftone - (x[i][1] - boxlo[1]) * delyinv;
+    const FFT_SCALAR dz = nz + shiftone - (x[i][2] - boxlo[2]) * delzinv;
+
+    compute_rho1d_and_drho1d(dx, dy, dz);
+
+    FFT_SCALAR egrid[3] = {ZEROF, ZEROF, ZEROF};
+    for (int n = nlower; n <= nupper; n++) {
+      const int mz = n + nz;
+      const FFT_SCALAR z0 = rho1d[2][n];
+      const FFT_SCALAR dz0 = drho1d[2][n];
+      for (int m = nlower; m <= nupper; m++) {
+        const int my = m + ny;
+        const FFT_SCALAR y0 = rho1d[1][m];
+        const FFT_SCALAR yz = y0 * z0;
+        const FFT_SCALAR dyz = drho1d[1][m] * z0;
+        const FFT_SCALAR ydz = y0 * dz0;
+        FFT_SCALAR *urow = &u_disp_brick[0][mz][my][nx + nlower];
+        for (int l = nlower; l <= nupper; l++) {
+          const FFT_SCALAR u0 = urow[l - nlower];
+          egrid[0] += drho1d[0][l] * yz * u0;
+          egrid[1] += rho1d[0][l] * dyz * u0;
+          egrid[2] += rho1d[0][l] * ydz * u0;
+        }
+      }
+    }
+
+    const double coefficient = mode_weight * dispersion_coefficient(type[i], 0);
+    const double self_coefficient = coefficient * dispersion_coefficient(type[i], 0);
+    double efield[3];
+    for (int dim = 0; dim < 3; dim++) {
+      const double theta = (x[i][dim] - (triclinic ? boxlo[dim] : 0.0)) * h_inv[dim] * MY_2PI;
+      const double sf =
+          (sf_coeff_disp[2 * dim] + 2.0 * sf_coeff_disp[2 * dim + 1] * std::cos(theta)) *
+          std::sin(theta);
+      efield[dim] = coefficient * egrid[dim] * h_inv[dim] - 2.0 * self_coefficient * sf;
+    }
+
+    if (triclinic) x2lamdaT(efield, efield);
+    f[i][0] += efield[0];
+    f[i][1] += efield[1];
+    if (slabflag != 2) f[i][2] += efield[2];
+  }
+}
+
+/* ----------------------------------------------------------------------
+   map charge and one dispersion force in one AD stencil traversal
+------------------------------------------------------------------------- */
+
+void ESPDisp::fieldforce_geometric_ad()
+{
+  const double *prd = domain->prd;
+  const double h_inv[3] = {triclinic ? nx_pppm : nx_pppm / prd[0],
+                           triclinic ? ny_pppm : ny_pppm / prd[1],
+                           triclinic ? nz_pppm : nz_pppm / (prd[2] * slab_volfactor)};
+
+  double *q = atom->q;
+  double **x = atom->x;
+  double **f = atom->f;
+  int *type = atom->type;
+  const double qscale = qqrd2e * scale;
+  const double mode_weight = dispersion_weight[0];
+
+  for (int i = 0; i < atom->nlocal; i++) {
+    const int nx = part2grid[i][0];
+    const int ny = part2grid[i][1];
+    const int nz = part2grid[i][2];
+    const FFT_SCALAR dx = nx + shiftone - (x[i][0] - boxlo[0]) * delxinv;
+    const FFT_SCALAR dy = ny + shiftone - (x[i][1] - boxlo[1]) * delyinv;
+    const FFT_SCALAR dz = nz + shiftone - (x[i][2] - boxlo[2]) * delzinv;
+
+    compute_rho1d_and_drho1d(dx, dy, dz);
+
+    FFT_SCALAR ecoul[3] = {ZEROF, ZEROF, ZEROF};
+    FFT_SCALAR edisp[3] = {ZEROF, ZEROF, ZEROF};
+    const double dispersion = dispersion_coefficient(type[i], 0);
+    if (dispersion == 0.0) {
+      for (int n = nlower; n <= nupper; n++) {
+        const int mz = n + nz;
+        const FFT_SCALAR z0 = rho1d[2][n];
+        const FFT_SCALAR dz0 = drho1d[2][n];
+        for (int m = nlower; m <= nupper; m++) {
+          const int my = m + ny;
+          const FFT_SCALAR y0 = rho1d[1][m];
+          const FFT_SCALAR yz = y0 * z0;
+          const FFT_SCALAR dyz = drho1d[1][m] * z0;
+          const FFT_SCALAR ydz = y0 * dz0;
+          FFT_SCALAR *crow = &u_brick[mz][my][nx + nlower];
+          for (int l = nlower; l <= nupper; l++) {
+            const FFT_SCALAR rho = rho1d[0][l];
+            const FFT_SCALAR drho = drho1d[0][l];
+            const FFT_SCALAR ucoul = crow[l - nlower];
+            ecoul[0] += drho * yz * ucoul;
+            ecoul[1] += rho * dyz * ucoul;
+            ecoul[2] += rho * ydz * ucoul;
+          }
+        }
+      }
+    } else {
+      for (int n = nlower; n <= nupper; n++) {
+        const int mz = n + nz;
+        const FFT_SCALAR z0 = rho1d[2][n];
+        const FFT_SCALAR dz0 = drho1d[2][n];
+        for (int m = nlower; m <= nupper; m++) {
+          const int my = m + ny;
+          const FFT_SCALAR y0 = rho1d[1][m];
+          const FFT_SCALAR yz = y0 * z0;
+          const FFT_SCALAR dyz = drho1d[1][m] * z0;
+          const FFT_SCALAR ydz = y0 * dz0;
+          FFT_SCALAR *crow = &u_brick[mz][my][nx + nlower];
+          FFT_SCALAR *drow = &u_disp_brick[0][mz][my][nx + nlower];
+          for (int l = nlower; l <= nupper; l++) {
+            const int offset = l - nlower;
+            const FFT_SCALAR rho = rho1d[0][l];
+            const FFT_SCALAR drho = drho1d[0][l];
+            const FFT_SCALAR ucoul = crow[offset];
+            const FFT_SCALAR udisp = drow[offset];
+            ecoul[0] += drho * yz * ucoul;
+            ecoul[1] += rho * dyz * ucoul;
+            ecoul[2] += rho * ydz * ucoul;
+            edisp[0] += drho * yz * udisp;
+            edisp[1] += rho * dyz * udisp;
+            edisp[2] += rho * ydz * udisp;
+          }
+        }
+      }
+    }
+
+    const double coefficient = mode_weight * dispersion;
+    const double self_coefficient = coefficient * dispersion;
+    double fcoul[3], fdisp[3];
+    for (int dim = 0; dim < 3; dim++) {
+      const double theta = (x[i][dim] - (triclinic ? boxlo[dim] : 0.0)) * h_inv[dim] * MY_2PI;
+      const double sine = std::sin(theta);
+      const double cosine = std::cos(theta);
+      const double sf_coul = (sf_coeff[2 * dim] + 2.0 * sf_coeff[2 * dim + 1] * cosine) * sine;
+      const double sf_disp =
+          (sf_coeff_disp[2 * dim] + 2.0 * sf_coeff_disp[2 * dim + 1] * cosine) * sine;
+      fcoul[dim] = q[i] * ecoul[dim] * h_inv[dim] - 2.0 * q[i] * q[i] * sf_coul;
+      fdisp[dim] = coefficient * edisp[dim] * h_inv[dim] - 2.0 * self_coefficient * sf_disp;
+    }
+
+    if (triclinic) {
+      x2lamdaT(fcoul, fcoul);
+      x2lamdaT(fdisp, fdisp);
+    }
+    f[i][0] += qscale * fcoul[0] + fdisp[0];
+    f[i][1] += qscale * fcoul[1] + fdisp[1];
+    if (slabflag != 2) f[i][2] += qscale * fcoul[2] + fdisp[2];
+  }
+}
+
+/* ---------------------------------------------------------------------- */
+
+void ESPDisp::fieldforce_dispersion_peratom()
+{
+  double **x = atom->x;
+  int *type = atom->type;
+  int **grid = part2grid_disp;
+
+  for (int index = 0; index < ndisp; index++) {
+    const int i = disp_sites[index];
+    const int nx = grid[i][0];
+    const int ny = grid[i][1];
+    const int nz = grid[i][2];
+    const FFT_SCALAR dx = nx + shiftone - (x[i][0] - boxlo[0]) * delxinv;
+    const FFT_SCALAR dy = ny + shiftone - (x[i][1] - boxlo[1]) * delyinv;
+    const FFT_SCALAR dz = nz + shiftone - (x[i][2] - boxlo[2]) * delzinv;
+
+    compute_rho1d(dx, dy, dz);
+
+    std::fill(u_disp_atom.begin(), u_disp_atom.end(), ZEROF);
+    std::fill(virial_disp_atom.begin(), virial_disp_atom.end(), std::array<FFT_SCALAR, 6>{});
+    for (int n = nlower; n <= nupper; n++) {
+      const int mz = n + nz;
+      const FFT_SCALAR z0 = rho1d[2][n];
+      for (int m = nlower; m <= nupper; m++) {
+        const int my = m + ny;
+        const FFT_SCALAR y0 = z0 * rho1d[1][m];
+        for (int l = nlower; l <= nupper; l++) {
+          const int mx = l + nx;
+          const FFT_SCALAR weight = y0 * rho1d[0][l];
+          for (int field = 0; field < ndisp_fields; field++) {
+            if (eflag_atom) u_disp_atom[field] += weight * u_disp_brick[field][mz][my][mx];
+            if (vflag_atom)
+              for (int component = 0; component < 6; component++)
+                virial_disp_atom[field][component] +=
+                    weight * virial_disp_brick[field][component][mz][my][mx];
+          }
+        }
+      }
+    }
+
+    for (int field = 0; field < ndisp_fields; field++) {
+      const double coefficient = weighted_dispersion_coefficient(type[i], field);
+      if (eflag_atom) eatom[i] += 0.5 * coefficient * u_disp_atom[field];
+      if (vflag_atom)
+        for (int component = 0; component < 6; component++)
+          vatom[i][component] += 0.5 * coefficient * virial_disp_atom[field][component];
+    }
+    if (eflag_atom) eatom[i] += 0.5 * self_disp * dispersion_self_coefficient(type[i]);
+  }
+}
