+static void symmetric_tensor_product(const double *a, const double *b, double *result)
+{
+  result[0] = a[0] * b[0];
+  result[1] = a[1] * b[1];
+  result[2] = a[2] * b[2];
+  result[3] = 0.5 * (a[0] * b[1] + a[1] * b[0]);
+  result[4] = 0.5 * (a[0] * b[2] + a[2] * b[0]);
+  result[5] = 0.5 * (a[1] * b[2] + a[2] * b[1]);
+}
+
+namespace {
+
+struct TIP4PPeratomContribution {
+  tagint tag;
+  double energy;
+  double virial[6];
+};
+
+struct TIP4PPeratomContext {
+  Atom *atom;
+  double *eatom;
+  double **vatom;
+  int eflag;
+  int vflag;
+};
+
+void unpack_tip4p_peratom(int n, char *buffer, void *ptr)
+{
+  auto *context = static_cast<TIP4PPeratomContext *>(ptr);
+  auto *contribution = reinterpret_cast<TIP4PPeratomContribution *>(buffer);
+  const int nlocal = context->atom->nlocal;
+
+  for (int i = 0; i < n; i++) {
+    const int index = context->atom->map(contribution[i].tag);
+    if (index < 0 || index >= nlocal) continue;
+
+    if (context->eflag) context->eatom[index] += contribution[i].energy;
+    if (context->vflag)
+      for (int j = 0; j < 6; j++)
+        context->vatom[index][j] += contribution[i].virial[j];
+  }
+}
