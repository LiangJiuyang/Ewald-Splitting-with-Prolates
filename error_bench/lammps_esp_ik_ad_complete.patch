+
+  deallocate_dispersion_grid();
+  deallocate_dispersion_peratom();
+  memory->destroy(part2grid_disp);
+  memory->destroy(disp_sites);
+  memory->destroy(fourier_disp);
+  memory->destroy(force_disp);
+  memory->destroy(energy_disp);
+  delete[] B;
+}
