+/* ---------------------------------------------------------------------- */
+
+void ESPDisp::init()
+{
+  if (!force->pair) error->all(FLERR, "Kspace style esp/disp requires a pair style");
+
+  int dim = 0;
+  auto *p_cutoff = (double *) force->pair->extract("cut_vdwl", dim);
+  auto *epsilon = (double **) force->pair->extract("epsilon", dim);
+  auto *sigma = (double **) force->pair->extract("sigma", dim);
+  auto *coefficients = (double **) force->pair->extract("B", dim);
+  auto *mix = (int *) force->pair->extract("ewald_mix", dim);
+
+  if (!p_cutoff || !epsilon || !sigma || !coefficients || !mix)
+    error->all(FLERR, "Pair style is incompatible with esp/disp");
+  if (*mix != Pair::GEOMETRIC && *mix != Pair::ARITHMETIC && *mix != Pair::SIXTHPOWER)
+    error->all(FLERR,
+               "Kspace style esp/disp requires geometric, arithmetic, or sixthpower pair mixing");
+
+  cutoff_disp = *p_cutoff;
+  dispersion_mixing = *mix;
+  MathPSWF::prolc180(accuracy_relative, select_c_disp);
+  init_dispersion_coeffs(epsilon, sigma, coefficients);
+
+  ESP::init();
+
+  memory->destroy(fourier_disp);
+  std::vector<double> coeffs;
+  MathPSWF::dispersion_fourier_poly(0.1 * accuracy_relative, select_c_disp, cutoff_disp, coeffs);
+  num_fourier_disp = static_cast<int>(coeffs.size());
+  memory->create(fourier_disp, num_fourier_disp, "esp/disp:fourier");
+  for (int i = 0; i < num_fourier_disp; i++) fourier_disp[i] = coeffs[i];
+
+  memory->destroy(force_disp);
+  coeffs.clear();
+  MathPSWF::dispersion_force_poly(0.1 * accuracy_relative, select_c_disp, coeffs);
+  num_force_disp = static_cast<int>(coeffs.size());
+  memory->create(force_disp, num_force_disp, "esp/disp:force");
+  for (int i = 0; i < num_force_disp; i++) force_disp[i] = coeffs[i];
+
+  memory->destroy(energy_disp);
+  coeffs.clear();
+  MathPSWF::dispersion_energy_poly(0.01 * accuracy_relative, select_c_disp, coeffs);
+  num_energy_disp = static_cast<int>(coeffs.size());
+  memory->create(energy_disp, num_energy_disp, "esp/disp:energy");
+  for (int i = 0; i < num_energy_disp; i++) energy_disp[i] = coeffs[i];
+
+  self_disp = MathPSWF::dispersion_self(select_c_disp, cutoff_disp);
+  dispersion_sum();
+
+  if (me == 0) {
+    const char *mix_name = "none";
+    if (mixflag == 1)
+      mix_name = "geometric (forced)";
+    else if (mixflag == 0) {
+      mix_name = "arithmetic";
+      if (dispersion_mixing == Pair::GEOMETRIC) mix_name = "geometric";
+      if (dispersion_mixing == Pair::SIXTHPOWER) mix_name = "sixthpower";
+    }
+    utils::logmesg(lmp,
+                   "  Dispersion splitting parameter c = {:.8g}\n"
+                   "  Dispersion mixing rule = {} ({} structure factor{})\n"
+                   "  Dispersion Fourier poly size = {}\n",
+                   select_c_disp, mix_name, ndisp_fields, ndisp_fields == 1 ? "" : "s",
+                   num_fourier_disp);
+    if (dispersion_truncation_error > 0.0)
+      utils::logmesg(lmp, "  Estimated dispersion coefficient truncation error = {:.8g}\n",
+                     dispersion_truncation_error);
+  }
+}
