+static inline std::array<double, 7> lege_derivatives(double x, const double *pexp, int n,
+                                                     int max_derivative)
+{
+  std::array<double, 7> result{};
+  std::array<double, 7> pjm2{};
+  std::array<double, 7> pjm1{};
+  std::array<double, 7> pj{};
+
+  pjm2[0] = 1.0;
+  result[0] = pexp[0];
+  if (n == 0) return result;
+
+  pjm1[0] = x;
+  pjm1[1] = 1.0;
+  for (int m = 0; m <= max_derivative; m++) result[m] += pexp[1] * pjm1[m];
+
+  for (int j = 2; j <= n; j++) {
+    for (int m = 0; m <= max_derivative; m++) {
+      const double product_derivative = x * pjm1[m] + (m ? m * pjm1[m - 1] : 0.0);
+      pj[m] = ((2 * j - 1) * product_derivative - (j - 1) * pjm2[m]) / j;
+      result[m] += pexp[j] * pj[m];
+    }
+    pjm2 = pjm1;
+    pjm1 = pj;
+  }
+
+  return result;
+}
