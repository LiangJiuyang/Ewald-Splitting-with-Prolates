+void ESPDisp::pack_reverse_grid(int flag, void *vbuf, int nlist, int *list)
+{
+  if (flag != REVERSE_RHO_G) {
+    ESP::pack_reverse_grid(flag, vbuf, nlist, list);
+    return;
+  }
+
+  auto *buf = (FFT_SCALAR *) vbuf;
+  FFT_SCALAR *coul = &density_brick[nzlo_out][nylo_out][nxlo_out];
+  for (int field = 0; field < ndisp_fields; field++)
+    scalar_disp_ptrs[field] = &density_disp_brick[field][nzlo_out][nylo_out][nxlo_out];
+  int n = 0;
+  for (int i = 0; i < nlist; i++) {
+    buf[n++] = coul[list[i]];
+    for (int field = 0; field < ndisp_fields; field++) buf[n++] = scalar_disp_ptrs[field][list[i]];
+  }
+}
+
+void ESPDisp::unpack_reverse_grid(int flag, void *vbuf, int nlist, int *list)
+{
+  if (flag != REVERSE_RHO_G) {
+    ESP::unpack_reverse_grid(flag, vbuf, nlist, list);
+    return;
+  }
+
+  auto *buf = (FFT_SCALAR *) vbuf;
+  FFT_SCALAR *coul = &density_brick[nzlo_out][nylo_out][nxlo_out];
+  for (int field = 0; field < ndisp_fields; field++)
+    scalar_disp_ptrs[field] = &density_disp_brick[field][nzlo_out][nylo_out][nxlo_out];
+  int n = 0;
+  for (int i = 0; i < nlist; i++) {
+    coul[list[i]] += buf[n++];
+    for (int field = 0; field < ndisp_fields; field++) scalar_disp_ptrs[field][list[i]] += buf[n++];
+  }
+}
