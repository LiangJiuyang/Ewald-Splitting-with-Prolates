# Equilibrated all-atom SPC/E configurations for the large-system window scan.
# The 30 A, 901-molecule snapshot is replicated before a short NVT relaxation,
# yielding 7,208 waters (21,624 atoms) in a 60 A cubic periodic cell.

newton on
units real
atom_style full
read_data numerical_examples/water_trajectory_benchmark/water.data
replicate 2 2 2
reset_timestep 0

bond_style harmonic
angle_style harmonic
bond_coeff 1 0.0 1.000
angle_coeff 1 0.0 109.47
special_bonds lj/coul 0 0 0.5

pair_style lj/cut/coul/long 9.0
pair_coeff 1 1 0.15535 3.166
pair_coeff 1 2 0.0 1.0
pair_coeff 2 2 0.0 1.0
kspace_style pppm 1.0e-5

neighbor 1.0 bin
neigh_modify every 1 delay 0 check yes one 2000
timestep 1.0
velocity all create 300.0 892731 mom yes rot yes dist gaussian
fix sh all shake 1.0e-4 20 0 b 1 a 1
fix nvt all nvt temp 300.0 300.0 100.0

thermo_style custom step temp pe etotal press
thermo 250
run 1000

dump trj all custom 250 numerical_examples/large_water_window_upsampling/large_water_short_traj.lammpstrj id mol type q x y z ix iy iz
dump_modify trj sort id format line "%d %d %d %.8g %.17g %.17g %.17g %d %d %d"
run 1000
