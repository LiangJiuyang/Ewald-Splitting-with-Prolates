; Energy minimization before equilibration
define                  = -DPOSRES -DPOSRES_FC_BB=1000.0 -DPOSRES_FC_SC=100.0

integrator              = steep
emtol                   = 500.0
emstep                  = 0.01
nsteps                  = 50000

cutoff-scheme           = Verlet
nstlist                 = 50
rlist                   = 1.05
coulombtype             = PME
rcoulomb                = 1.0
vdwtype                 = Cut-off
vdw-modifier            = Potential-shift-Verlet
rvdw                    = 1.0
DispCorr                = EnerPres
fourierspacing          = 0.12

pbc                     = xyz
constraints             = h-bonds
constraint_algorithm    = LINCS

nstenergy               = 500
nstlog                  = 500
