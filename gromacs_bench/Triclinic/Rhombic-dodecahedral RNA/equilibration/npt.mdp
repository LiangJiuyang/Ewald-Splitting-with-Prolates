; NPT equilibration with position restraints
define                  = -DPOSRES -DPOSRES_FC_BB=1000.0 -DPOSRES_FC_SC=100.0

integrator              = md
dt                      = 0.002
nsteps                  = 500000

cutoff-scheme           = Verlet
nstlist                 = 50
rlist                   = 1.05
coulombtype             = PME
rcoulomb                = 1.0
vdwtype                 = Cut-off
vdw-modifier            = Potential-shift-Verlet
rvdw                    = 1.0
DispCorr                = EnerPres
fourierspacing          = 0.12

tcoupl                  = V-rescale
tc-grps                 = System
tau_t                   = 0.5
ref_t                   = 303.15

pcoupl                  = C-rescale
pcoupltype              = isotropic
tau_p                   = 5.0
compressibility         = 4.5e-5
ref_p                   = 1.0
refcoord_scaling        = com

constraints             = h-bonds
constraint-algorithm    = LINCS
continuation            = yes
gen-vel                 = no

pbc                     = xyz

nstxout-compressed      = 5000
compressed-x-grps       = System-XTC
nstenergy               = 500
nstlog                  = 500
nstcalcenergy           = 100
