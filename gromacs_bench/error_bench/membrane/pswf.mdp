integrator           = md
tinit                = 0.0
dt                   = 0.002
nsteps               = 50000000
nstxout              = 0 ;500000
nstvout              = 0 ;500000
nstfout              = 0
nstlog               = 5000
nstenergy            = 5000
nstxtcout            = 5000

vdw-type             = Cut-off

nstlist		= 20		; 40 fs
rlist               =  1.0		; Cut-off for making neighbor list (short range forces), ignored by Verlet
rvdw = 0.9
coulombtype = pme
rcoulomb = 0.9
pme_order = 8
fourierspacing	= 0.2		; grid spacing for FFT

Tcoupl               = V-rescale 
tc-grps              = Protein Lipid SOL_ION
tau-t                = 0.1 0.1 0.1 
ref-t                = 323. 323. 323.
energygrps           = Protein Lipid SOL_ION
;Pcoupl               = Parrinello-Rahman
;Pcoupltype           = semiisotropic
;tau-p                = 1.0
;compressibility      = 4.5E-5 4.5E-5
;ref-p                = 1.0 1.0
gen_vel              = no ;yes  
;gen-temp             = 323
;gen-seed             = -1
constraints          = all-bonds
constraint-algorithm = Lincs
cutoff-scheme       =  Verlet           ; To run on GPUs
verlet-buffer-tolerance =  0.005        ; indirectly sets rlist
vdw-modifier        =  Potential-shift-Verlet        ; Shifts the vdw to be zero at cutoff
DispCorr            =  EnerPres

